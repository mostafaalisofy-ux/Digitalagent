# Cloudflare Pages headers. Rules are matched by path; the most specific rules add to the general one.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Never let the *.pages.dev copies (production alias and every preview deployment) be indexed:
# only www.saytamm.com should appear in search.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Fingerprinted build assets never change: cache for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and brand files change rarely
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=2592000

# Images and video: a week in browsers
/work/*
  Cache-Control: public, max-age=604800
/clients/*
  Cache-Control: public, max-age=604800
/visuals/*
  Cache-Control: public, max-age=604800
/team/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=604800
