---
import { type Lang } from '../../config/site';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const d = t(Astro.props.lang).cred;
const rows = [d.markets, d.sectors, d.platforms];
---
<section class="cred" aria-label={d.title}>
  <div class="container">
    <div class="cred__in">
      <p class="eyebrow cred__title">{d.title}</p>
      <dl class="cred__rows">
        {rows.map((r, i) => (
          <div class="cred__row" data-reveal style={`--delay:${i * 90}ms`}>
            <dt class="eyebrow">{r.k}</dt>
            <dd><ul role="list">{r.v.map((v) => <li class:list={{ latin: /^[A-Za-z]/.test(v) }}>{v}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
<style>
  .cred { border-block: 1px solid var(--line); }
  .cred__in { display: grid; gap: var(--s-5); padding-block: var(--s-7); }
  .cred__rows { display: grid; gap: 0; }
  .cred__row { display: grid; grid-template-columns: 1fr; gap: var(--s-2); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .cred__row:first-child { border-top: 0; }
  .cred__row ul { display: flex; flex-wrap: wrap; column-gap: var(--s-5); row-gap: var(--s-1); }
  .cred__row li { font-size: var(--fs-h3); font-weight: 500; color: var(--text-strong); letter-spacing: var(--track-head); }
  .cred__row ul { column-gap: var(--s-6); }
  .cred__row li { position: relative; }
  @media (max-width: 1023px) { .cred__row ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--s-4); } .cred__row li::before { display: none; } }
  .cred__row li:not(:first-child)::before { content: ''; position: absolute; inset-inline-start: calc(var(--s-6) / -2 - 3px); top: 50%; width: 6px; height: 6px; background: var(--accent); transform: translateY(-50%) skewX(-45deg); }
  :global([dir='rtl']) .cred__row li:not(:first-child)::before { transform: translateY(-50%) skewX(45deg); }
  @media (min-width: 1024px) {
    .cred__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; padding-block: var(--s-8); }
    .cred__title { grid-column: 1 / span 3; padding-top: var(--s-4); }
    .cred__rows { grid-column: 4 / -1; }
    .cred__row { grid-template-columns: 160px 1fr; align-items: baseline; }
  }
</style>
