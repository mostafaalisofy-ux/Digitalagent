---
import { type Lang } from '../../config/site';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const d = t(Astro.props.lang).philosophy;
const last = d.title.length - 1;
---
<section class="section phil" aria-labelledby="phil-title">
  <div class="container">
    <p class="eyebrow phil__eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span><span class="num">02</span><span>{d.eyebrow}</span></p>
    <h2 class="phil__title" id="phil-title" data-reveal-group>
      {d.title.map((l, i) => (
        <span class:list={['line', { 'phil__last': i === last }]} style={`--delay:${i * 110}ms`}><span>{l}</span></span>
      ))}
    </h2>
    <div class="phil__body grid">
      <p class="phil__lead" data-reveal>{d.body}</p>
      <ol role="list" class="phil__points">
        {d.points.map((p, i) => (
          <li data-reveal style={`--delay:${i * 100}ms`}>
            <span class="num phil__n">0{i + 1}</span>
            <h3>{p.k}</h3>
            <p>{p.v}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .phil__eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .phil__eyebrow .num { color: var(--text-strong); }
  .phil__title { margin-top: var(--s-6); font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: var(--track-tight); max-width: 16ch; }
  [dir='rtl'] .phil__title { max-width: 14ch; }
  /* the final line steps along the diagonal and carries a blade-angle underline */
  .phil__last > span { position: relative; }
  .phil__last > span::after { content: ''; position: absolute; inset-inline-start: 0.04em; bottom: -0.11em; height: 0.08em; width: 0; background: var(--accent); transform: skewX(-45deg); transition: width var(--d-5) var(--ease-out) 600ms; }
  [dir='rtl'] .phil__last > span::after { transform: skewX(45deg); }
  .phil__title.is-in .phil__last > span::after { width: 100%; }
  :global(html:not(.js)) .phil__last > span::after { width: 100%; }
  .phil__body { margin-top: var(--s-9); row-gap: var(--s-7); }
  .phil__lead { grid-column: 1 / -1; font-size: var(--fs-lead); line-height: 1.5; color: var(--text); max-width: 40ch; }
  .phil__points { grid-column: 1 / -1; display: grid; gap: 0; }
  .phil__points li { display: grid; grid-template-columns: 48px 1fr; column-gap: var(--s-3); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .phil__n { grid-row: span 2; font-size: var(--fs-caption); color: var(--accent-text); padding-top: 6px; }
  .phil__points h3 { font-size: var(--fs-h3); }
  .phil__points p { color: var(--text-muted); margin-top: var(--s-2); }
  @media (min-width: 1024px) {
    .phil__lead { grid-column: 1 / span 5; }
    .phil__points { grid-column: 7 / -1; }
  }
</style>
