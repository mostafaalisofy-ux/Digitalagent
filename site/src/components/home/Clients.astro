---
// SayTamm's direct clients (owner-confirmed). Official logos in their own colours on light tiles;
// a client without a supplied logo file is set as its name. Separate from Brands (team experience).
import { CLIENTS, visibleWall } from '../../data/clients';
import { SITE } from '../../config/site';
import { type Lang } from '../../config/site';
import { caseHref } from '../../i18n/paths';
import { h } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = h(lang).clients;
// clients with an official logo first, name-only clients after (stable order within each group)
const list = [...CLIENTS.filter((c) => c.logo), ...CLIENTS.filter((c) => !c.logo)];
const wall = visibleWall();
const moreTitle = lang === 'ar' ? 'ومن عملائنا أيضاً' : 'Also among our clients';
---
<section class="section cl" id="clients" aria-labelledby="cl-title">
  <div class="container cl__grid">
    <header class="cl__head">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h2 class="cl__title" id="cl-title" data-reveal>{d.title}</h2>
      <p class="cl__intro" data-reveal>{d.intro}</p>
    </header>
    <ul role="list" class="cl__list" data-reveal-group>
      {list.map((c, i) => (
        <li class="cl__item" style={`--delay:${Math.min(i, 8) * 60}ms`}>
          <div class:list={['cl__tile', { 'cl__tile--fill': c.fill }]} style={c.tile ? `background:${c.tile}` : undefined}>
            {(lang === 'ar' && c.logoAr) || c.logo
              ? (() => { const l = (lang === 'ar' && c.logoAr) || c.logo!; return <img src={l.src} width={l.w} height={l.h} alt={c.name[lang]} loading="lazy" decoding="async" />; })()
              : <span class="cl__word">{c.name[lang]}</span>}
          </div>
          <p class="cl__name">{c.name[lang]}{c.sector && <span class="cl__sector"> · {c.sector[lang]}</span>}</p>
          {c.caseSlug && <a class="link-diag cl__case" href={caseHref(lang, c.caseSlug)}>{h(lang).brands.caseLink}</a>}
        </li>
      ))}
    </ul>
    {wall.length > 0 && (
      <div class="clw">
        <h3 class="clw__h">{moreTitle} <bdi class="num latin clw__n">{wall.length}</bdi></h3>
        <ul role="list" class="clw__list">
          {wall.map((c) => (
            <li class="clw__item" title={c.name[lang]}>
              <img src={c.logo.src} width={c.logo.w} height={c.logo.h} alt={c.name[lang]} loading="lazy" decoding="async" />
              {SITE.preview && c.permission === 'pending' && <span class="clw__tag" title={lang === 'ar' ? 'جهة حكومية: بانتظار إذن العرض' : 'Government body: display permission pending'}><span class="visually-hidden">{lang === 'ar' ? 'بانتظار إذن العرض' : 'Display permission pending'}</span></span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
<style>
  .cl { border-top: 1px solid var(--line); }
  .cl__grid { display: grid; gap: var(--s-7); }
  .cl__head { display: grid; gap: var(--s-4); align-content: start; }
  .cl .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .cl__title { font-size: var(--fs-h1); letter-spacing: var(--track-tight); line-height: var(--lh-head); }
  .cl__intro { color: var(--text); font-size: var(--fs-lead); max-width: 36ch; }
  .cl__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-3); min-width: 0; }
  @media (min-width: 600px) { .cl__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cl__item { min-width: 0; }
  .cl__item { display: grid; gap: var(--s-3); align-content: start; }
  :global(.js) .cl__item { opacity: 0; transform: translate3d(0, 16px, 0); transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out); transition-delay: var(--delay); }
  :global(.js) .cl__list:global(.is-in) .cl__item { opacity: 1; transform: none; }
  /* light tile so official logo colours read as intended (never recoloured for the dark theme) */
  /* soft white from the palette keeps logo colours true without a hard white block on the dark page */
  .cl__tile { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; width: 100%; background: var(--c-soft-white); overflow: hidden; }
  .cl__tile img { position: absolute; inset: 16% 18%; width: 64%; height: 68%; object-fit: contain; }
  .cl__tile--fill img { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* client without a logo file: set as a plain name, quiet, so it never reads as a redrawn logo */
  .cl__word { padding: 0 var(--s-3); text-align: center; font-size: var(--fs-small); font-weight: 500; line-height: 1.3; color: #55525e; letter-spacing: 0; }
  :global([dir='rtl']) .cl__word { letter-spacing: 0; }
  .cl__name { font-size: var(--fs-caption); font-weight: 500; color: var(--text-strong); line-height: 1.35; }
  .cl__sector { color: var(--text-muted); font-weight: 400; }
  /* logo wall: reverse (light) logos as supplied, on graphite, never recoloured */
  .clw { grid-column: 1 / -1; display: grid; gap: var(--s-4); margin-top: var(--s-6); }
  .clw__h { font-size: var(--fs-small); font-weight: 500; color: var(--text-muted); }
  .clw__n { color: var(--accent-text); margin-inline-start: var(--s-2); }
  .clw__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .clw__item { position: relative; aspect-ratio: 16 / 10; background: var(--c-graphite); min-width: 0; overflow: hidden; }
  .clw__item img { position: absolute; inset: 18% 16%; width: 68%; height: 64%; object-fit: contain; }
  .clw__tag { position: absolute; inset-block-start: 6px; inset-inline-end: 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--c-purple-200); }
  @media (min-width: 600px) { .clw__list { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .clw__list { grid-template-columns: repeat(8, minmax(0, 1fr)); } }
  @media (min-width: 1440px) { .clw__list { grid-template-columns: repeat(10, minmax(0, 1fr)); } }
  .cl__case { justify-self: start; font-size: var(--fs-caption); color: var(--accent-text); }
  @media (min-width: 1024px) {
    .cl__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .cl__head { grid-column: 1 / span 4; }
    .cl__list { grid-column: 5 / -1; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (min-width: 1440px) { .cl__list { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  }
  @media (prefers-reduced-motion: reduce) { :global(.js) .cl__item { opacity: 1; transform: none; } }
</style>
