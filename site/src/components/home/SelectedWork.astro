---
import SectionHead from '../SectionHead.astro';
import CaseVisual from '../CaseVisual.astro';
import { featured } from '../../data/cases';
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).work;
---
<section class="section work" aria-labelledby="work-title">
  <div class="container">
    <div class="work__head">
      <SectionHead n="04" eyebrow={d.eyebrow} title={d.title} id="work-title" size="display" />
      <p class="work__label" data-reveal><span class="placeholder-tag">{lang === 'ar' ? 'سجل الفريق' : 'Track record'}</span>{d.label}</p>
    </div>
    <ul role="list" class="work__grid">
      {featured.map((c, i) => {
        const k = c.kpis.find((x) => x.accent) ?? c.kpis[0];
        return (
          <li class:list={['wc', `wc--${i}`]}>
            <a class="wc__link" href={href(lang, 'work', c.slug)} data-track="case_study_view" data-cta-id={c.slug} data-cta-location="home_work">
              <CaseVisual id={`home-${c.slug}`} label={d.visual} kpi={k.value} ratio={i === 0 ? '16 / 11' : '4 / 3'} />
              <div class="wc__meta">
                <p class="wc__tags"><span>{c.sector[lang]}</span><span>{c.market[lang]}</span>{c.period && <span>{c.period[lang]}</span>}</p>
                <h3 class="wc__client">{c.client[lang]}</h3>
                <p class="wc__headline">{c.headline[lang]}</p>
                <p class="wc__kpi"><span class="num latin">{k.value}</span><span>{k.label[lang]}</span></p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="work__foot"><a class="btn" href={href(lang, 'work')} data-track="cta_click" data-cta-id="explore_work" data-cta-location="home_work">{d.all}<span class="arrow" aria-hidden="true"></span></a></div>
  </div>
</section>
<style>
  .work__head { display: grid; gap: var(--s-5); margin-bottom: var(--s-8); }
  .work__label { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); color: var(--text-muted); font-size: var(--fs-small); max-width: 60ch; }
  .work__grid { display: grid; gap: var(--s-8) var(--gutter); }
  .wc__link { display: grid; gap: var(--s-4); }
  .wc__meta { display: grid; gap: var(--s-2); }
  .wc__tags { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); font-size: var(--fs-caption); color: var(--text-muted); }
  .wc__tags span:not(:last-child)::after { content: '·'; margin-inline-start: var(--s-3); }
  .wc__client { font-size: var(--fs-h2); letter-spacing: var(--track-tight); transition: color var(--d-2); }
  .wc__headline { color: var(--text); max-width: 44ch; }
  .wc__kpi { display: flex; align-items: baseline; gap: var(--s-3); margin-top: var(--s-2); color: var(--text-muted); font-size: var(--fs-small); }
  .wc__kpi .num { font-size: var(--fs-h1); font-weight: 700; color: var(--text-strong); line-height: 1; }
  .wc__link:hover .wc__client { color: var(--accent-text); }
  .work__foot { margin-top: var(--s-9); display: flex; justify-content: center; }
  @media (min-width: 1024px) {
    .work__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; column-gap: var(--gutter); }
    .work__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .wc--0 { grid-column: 1 / span 7; }
    .wc--1 { grid-column: 9 / span 4; margin-top: var(--s-12); }
    .wc--2 { grid-column: 2 / span 5; }
    .wc--3 { grid-column: 8 / span 5; margin-top: calc(var(--s-10) * -1); }
    .wc--0 .wc__client { font-size: var(--fs-h1); }
  }
</style>
