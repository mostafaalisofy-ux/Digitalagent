---
// Selected work: each project told in full — client, industry, market, period, objective,
// challenge, strategy, execution, outcome — with real visuals and a link to the complete case.
import CaseMedia from '../work/CaseMedia.astro';
import { homeSelection, showFigures, isPending } from '../../data/cases';
import { SITE, type Lang } from '../../config/site';
import { href, caseHref } from '../../i18n/paths';
import { h } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = h(lang).selected;
const r = h(lang).results;
const story = ['context', 'challenge', 'strategy', 'execution'] as const;
---
<section class="section sw" id="work" aria-labelledby="sw-title">
  <div class="container">
    <header class="sw__head">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h2 class="sw__title" id="sw-title" data-reveal-group><span class="line"><span>{d.title}</span></span></h2>
      <p class="sw__intro" data-reveal>{d.intro}</p>
      <p class="sw__label" data-reveal>{d.label}</p>
    </header>
  </div>

  {homeSelection.map((c, i) => {
    const lead = c.kpis.find((k) => k.accent) ?? c.kpis[0];
    const rest = c.kpis.filter((k) => k !== lead);
    const figures = showFigures(c);
    return (
      <article class:list={['ch', { 'ch--flip': i % 2 === 1 }]} aria-labelledby={`ch-${c.slug}`}>
        <div class="container">
          <header class="ch__top" data-reveal>
            <span class="num latin ch__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="ch__client" id={`ch-${c.slug}`}>{c.client[lang]}</h3>
            <dl class="ch__meta">
              <div><dt>{d.f.industry}</dt><dd>{c.sector[lang]}</dd></div>
              {c.market && <div><dt>{d.f.market}</dt><dd>{c.market[lang]}</dd></div>}
              {c.period && <div><dt>{d.f.period}</dt><dd>{c.period[lang]}</dd></div>}
            </dl>
          </header>
          <div class="ch__grid">
            <div class="ch__visual"><CaseMedia c={c} lang={lang} /></div>
            <div class="ch__text">
              <p class="ch__headline" data-reveal>{c.headline[lang]}</p>
              <dl class="ch__story" data-reveal>
                {story.map((k) => <div><dt>{d.f[k]}</dt><dd>{c[k][lang]}</dd></div>)}
              </dl>
            </div>
          </div>
          <div class="ch__outcome" data-reveal>
            <p class="ch__olabel">{d.f.outcome}{figures && isPending(c) && SITE.preview && <span class="tag-pending">{r.pending}</span>}</p>
            {figures ? (
              <div class="ch__figs">
                <p class="ch__lead"><bdi class="num latin">{lead.value}</bdi><span>{lead.label[lang]}</span></p>
                <dl class="ch__kpis">{rest.map((k) => <div><dt>{k.label[lang]}</dt><dd class="num latin">{k.value}</dd></div>)}</dl>
              </div>
            ) : <p class="ch__withheld">{r.withheld}</p>}
            <p class="ch__osum">{figures ? c.outcome[lang] : ''}{c.note && figures && <span class="ch__note"> {c.note[lang]}</span>}</p>
            <a class="link-diag ch__link" href={caseHref(lang, c.slug)} data-track="case_study_view" data-cta-id={c.slug} data-cta-location="home_work">{d.read}</a>
          </div>
        </div>
      </article>
    );
  })}

  <div class="container sw__foot"><a class="btn" href={href(lang, 'work')} data-track="cta_click" data-cta-id="explore_work" data-cta-location="home_work">{d.all}<span class="arrow" aria-hidden="true"></span></a></div>
</section>

<style>
  .sw { padding-bottom: var(--s-10); }
  .sw__head { display: grid; gap: var(--s-4); max-width: 980px; }
  .sw .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .sw__title { font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: var(--track-tight); }
  .sw__intro { color: var(--text); font-size: var(--fs-lead); max-width: 48ch; }
  .sw__label { color: var(--text-muted); font-size: var(--fs-small); max-width: 70ch; }

  .ch { padding-block: var(--s-9); border-bottom: 1px solid var(--line); }
  .ch:first-of-type { margin-top: var(--s-8); border-top: 1px solid var(--line); }
  .ch__top { display: grid; gap: var(--s-3) var(--s-4); grid-template-columns: auto 1fr; align-items: baseline; padding-bottom: var(--s-6); }
  .ch__n { font-size: var(--fs-small); color: var(--accent-text); font-weight: 700; }
  .ch__client { font-size: var(--fs-h1); letter-spacing: var(--track-tight); line-height: 1.05; }
  .ch__meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); }
  .ch__meta div { display: grid; gap: 2px; }
  .ch__meta dt, .ch__story dt, .ch__olabel { font-size: var(--fs-eyebrow); text-transform: uppercase; letter-spacing: var(--track-eyebrow); color: var(--text-muted); font-weight: 500; }
  :global([dir='rtl']) .ch__meta dt, :global([dir='rtl']) .ch__story dt, :global([dir='rtl']) .ch__olabel { text-transform: none; letter-spacing: 0; font-size: var(--fs-caption); }
  .ch__meta dd { font-size: var(--fs-small); color: var(--text-strong); }

  .ch__grid { display: grid; gap: var(--s-6); }
  .ch__text { display: grid; gap: var(--s-5); align-content: start; }
  .ch__headline { font-size: var(--fs-h3); line-height: 1.35; font-weight: 500; color: var(--text-strong); max-width: 34ch; }
  .ch__story { display: grid; gap: var(--s-4); }
  .ch__story div { display: grid; gap: var(--s-1); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .ch__story dd { color: var(--text); line-height: 1.55; max-width: 52ch; }

  .ch__outcome { display: grid; gap: var(--s-4); margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--line-strong); }
  .ch__olabel { display: flex; align-items: center; gap: var(--s-3); }
  .ch__figs { display: grid; gap: var(--s-5); }
  .ch__lead { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--s-3); color: var(--text-muted); }
  .ch__lead .num { font-size: var(--fs-kpi); font-weight: 700; line-height: 0.9; letter-spacing: -0.045em; color: var(--text-strong); }
  .ch__kpis { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-7); }
  .ch__kpis div { display: flex; flex-direction: column-reverse; gap: 2px; }
  .ch__kpis dd { font-size: var(--fs-h2); font-weight: 700; line-height: 1; color: var(--text-strong); }
  .ch__kpis dt { font-size: var(--fs-caption); color: var(--text-muted); }
  .ch__osum { color: var(--text); max-width: 64ch; }
  .ch__note, .ch__withheld { color: var(--text-muted); font-size: var(--fs-small); }
  .ch__link { justify-self: start; color: var(--text-strong); }

  .sw__foot { margin-top: var(--s-9); }

  @media (min-width: 1024px) {
    .ch__top { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .ch__n { grid-column: 1; }
    .ch__client { grid-column: 2 / span 6; }
    .ch__meta { grid-column: 8 / -1; justify-content: flex-end; }
    .ch__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .ch__visual { grid-column: 1 / span 7; grid-row: 1; }
    .ch__text { grid-column: 9 / -1; grid-row: 1; }
    .ch--flip .ch__visual { grid-column: 6 / -1; }
    .ch--flip .ch__text { grid-column: 1 / span 4; }
    .ch__outcome { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .ch__olabel { grid-column: 1 / -1; }
    .ch__figs { grid-column: 1 / span 7; grid-template-columns: auto 1fr; align-items: end; gap: var(--s-7); }
    .ch__withheld { grid-column: 1 / span 7; }
    .ch__osum { grid-column: 9 / -1; grid-row: 2; }
    .ch__link { grid-column: 9 / -1; grid-row: 3; }
  }
</style>
