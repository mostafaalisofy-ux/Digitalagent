---
import Sculpture from '../Sculpture.astro';
import Pattern from '../Pattern.astro';
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
// split trailing full stop so the completion dot can carry the accent
const split = (s: string) => (s.endsWith('.') ? [s.slice(0, -1), '.'] : [s, '']);
const [l1, d1] = split(d.l1);
const [l2, d2] = split(d.l2);
---
<section class="hero" data-sculpture-host aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true"><Pattern id="hero-pat" opacity={0.1} size={22} /></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-reveal style="--delay:100ms"><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h1 class="hero__title" id="hero-title" data-reveal-group>
        <span class="line" style="--delay:180ms"><span>{l1}<span class="dot">{d1}</span></span></span>
        <span class="line hero__l2" style="--delay:300ms"><span>{l2}<span class="dot dot--accent">{d2}</span></span></span>
      </h1>
      <p class:list={['hero__alt', { latin: lang === 'ar' }]} lang={lang === 'ar' ? 'en' : 'ar'} dir={lang === 'ar' ? 'ltr' : 'rtl'} data-reveal style="--delay:520ms">{d.ar}</p>
      <p class="hero__sub" data-reveal style="--delay:620ms">{d.sub}</p>
      <div class="hero__ctas" data-reveal style="--delay:720ms">
        <a class="btn btn--primary" href={href(lang, 'contact')} data-track="cta_click" data-cta-id="start_project" data-cta-location="hero">{d.cta}<span class="arrow" aria-hidden="true"></span></a>
        <a class="btn" href={href(lang, 'work')} data-track="cta_click" data-cta-id="explore_work" data-cta-location="hero">{d.cta2}</a>
      </div>
    </div>
    <div class="hero__art">
      <Sculpture id="hero-sculpt" />
    </div>
  </div>
  <div class="container hero__foot" aria-hidden="true">
    <span class="num">01</span>
    <span class="hero__track"><span></span></span>
    <span>{d.scroll}</span>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-top: var(--s-6); isolation: isolate; }
  .hero__field { position: absolute; inset: 0 auto 0 0; width: 62%; z-index: -1;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 100%); mask-image: linear-gradient(90deg, #000 0%, transparent 100%); }
  [dir='rtl'] .hero__field { inset: 0 0 0 auto; -webkit-mask-image: linear-gradient(270deg, #000 0%, transparent 100%); mask-image: linear-gradient(270deg, #000 0%, transparent 100%); }
  .hero__grid { display: grid; grid-template-columns: 1fr; align-items: end; min-height: calc(100svh - 120px); row-gap: var(--s-6); padding-bottom: var(--s-6); }
  .hero__copy { position: relative; z-index: 2; display: grid; gap: var(--s-5); align-content: end; }
  .hero__eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .hero__title { font-size: var(--fs-mega); line-height: 0.86; letter-spacing: -0.055em; font-weight: 700; text-transform: none; }
  [dir='rtl'] .hero__title { line-height: 1.02; letter-spacing: 0; font-size: calc(var(--fs-mega) * 1.3); }
  .hero__l2 { padding-inline-start: 0.22em; }  /* asymmetric offset: the diagonal step */
  @media (min-width: 768px) { .hero__l2 { padding-inline-start: 0.62em; } }
  .dot--accent { color: var(--accent); }
  .hero__title .line > span { white-space: nowrap; }  /* the two lines never re-break, whatever the font metrics */
  .hero__alt { font-family: var(--font-ar); font-weight: 700; font-size: var(--fs-h2); color: var(--text-strong); line-height: 1.2; justify-self: start; }
  .hero__alt.latin { font-family: var(--font-en); letter-spacing: -0.02em; }
  .hero__sub { font-size: var(--fs-lead); color: var(--text-muted); max-width: 30ch; line-height: 1.45; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); padding-top: var(--s-2); }
  .hero__art { position: relative; z-index: 1; justify-self: end; width: min(78vw, 420px); margin-top: calc(var(--s-6) * -1); margin-inline-end: calc(var(--margin) * -0.2); }

  .hero__foot { display: flex; align-items: center; gap: var(--s-4); padding-block: var(--s-4) var(--s-6); font-size: var(--fs-caption); color: var(--text-muted); text-transform: uppercase; letter-spacing: var(--track-eyebrow); }
  .hero__track { position: relative; flex: 1; height: 1px; background: var(--line); overflow: hidden; }
  /* draws once, like a completion line — no loop */
  .hero__track span { position: absolute; inset-block: 0; inset-inline-start: 0; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); animation: track 1.6s var(--ease-out) 1.4s forwards; }
  [dir='rtl'] .hero__track span { transform-origin: right; }
  @keyframes track { to { transform: scaleX(0.32); } }

  @media (min-width: 768px) {
    .hero__art { width: min(52vw, 480px); }
  }
  @media (min-width: 1024px) {
    .hero { padding-top: 0; }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); min-height: calc(100svh - 150px); padding-bottom: var(--s-7); }
    .hero__copy { grid-column: 1 / span 8; grid-row: 1; padding-bottom: var(--s-4); }
    .hero__art { grid-column: 7 / -1; grid-row: 1; align-self: center; justify-self: end; width: min(40vw, 600px); margin: 0; transform: translate3d(4%, 4%, 0); }
    [dir='rtl'] .hero__art { transform: translate3d(-4%, 4%, 0); }
    .hero__sub { max-width: 34ch; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__track span { animation: none; transform: none; } }
</style>
