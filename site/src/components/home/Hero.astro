---
// Hero: the exact official symbol (flat, approved two-tone Signature, D-007/D-011) — no 3D effect,
// no redrawn geometry. The only motion is an entrance: the T settles, then the blade travels in
// along its own 45° diagonal to its exact resting position. Reduced motion: shown at rest.
import Logo from '../Logo.astro';
import Pattern from '../Pattern.astro';
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
const split = (s: string) => (s.endsWith('.') ? [s.slice(0, -1), '.'] : [s, '']);
const [l1, d1] = split(d.l1);
const [l2, d2] = split(d.l2);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-reveal style="--delay:80ms"><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h1 class="hero__title" id="hero-title" data-reveal-group>
        <span class="line" style="--delay:160ms"><span>{l1}<span class="dot">{d1}</span></span></span>
        <span class="line hero__l2" style="--delay:280ms"><span>{l2}<span class="dot dot--accent">{d2}</span></span></span>
      </h1>
      <p class="hero__sub" data-reveal style="--delay:480ms">{d.sub}</p>
      <div class="hero__ctas" data-reveal style="--delay:580ms">
        <a class="btn btn--primary" href={href(lang, 'contact')} data-track="cta_click" data-cta-id="start_project" data-cta-location="hero">{d.cta}<span class="arrow" aria-hidden="true"></span></a>
        <a class="link-diag hero__link" href={href(lang, 'work')} data-track="cta_click" data-cta-id="explore_work" data-cta-location="hero">{d.cta2}</a>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <div class="hero__field"><Pattern id="hero-pat" opacity={0.14} size={20} /></div>
      <div class="hero__mark" data-reveal-group><Logo variant="signature" height="100%" decorative /></div>
    </div>
  </div>
  <div class="container hero__foot" aria-hidden="true">
    <span class="hero__track"><span></span></span>
    <span>{d.scroll}</span>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-top: var(--s-5); isolation: isolate; }
  .hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); align-items: end; min-height: calc(100svh - 132px); padding-bottom: var(--s-6); }
  .hero__copy { position: relative; z-index: 2; display: grid; gap: var(--s-5); align-content: end; }
  .hero__eyebrow { padding-inline-end: 96px; }
  .hero__eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .hero__title { font-size: var(--fs-mega); line-height: 0.86; letter-spacing: -0.055em; font-weight: 700; }
  :global([dir='rtl']) .hero__title { line-height: 1.02; letter-spacing: 0; font-size: calc(var(--fs-mega) * 1.3); }
  @media (min-width: 1024px) { :global([dir='rtl']) .hero__title { font-size: calc(var(--fs-mega) * 0.86); line-height: 1; } }
  .hero__l2 { padding-inline-start: 0.22em; }
  @media (min-width: 768px) { .hero__l2 { padding-inline-start: 0.62em; } }
  .dot--accent { color: var(--accent); }
  .hero__title .line > span { white-space: nowrap; }
  .hero__sub { font-size: var(--fs-lead); color: var(--text); max-width: 38ch; line-height: 1.5; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); padding-top: var(--s-2); }
  .hero__link { color: var(--text-strong); font-size: var(--fs-small); }

  /* Mobile: the mark sits top-end, beside the eyebrow, at a size that keeps the CTA in the first view */
  .hero__art { position: absolute; top: 0; inset-inline-end: var(--margin); height: 104px; }
  .hero__mark { position: relative; z-index: 1; height: 100%; }
  .hero__field { display: none; }

  /* Entrance: T settles, blade slides in along its own diagonal (SVG user units; viewBox 600 × 721) */
  .hero__mark :global(.logo__t), .hero__mark :global(.logo__blade) { transition: transform 900ms var(--ease-out), opacity 700ms var(--ease-out); }
  :global(.js) .hero__mark :global(.logo__t) { opacity: 0; transform: translate(0, 24px); }
  :global(.js) .hero__mark :global(.logo__blade) { opacity: 0; transform: translate(-90px, 90px); transition-delay: 420ms; }
  :global(.js) .hero__mark.is-in :global(.logo__t), :global(.js) .hero__mark.is-in :global(.logo__blade) { opacity: 1; transform: none; }

  .hero__foot { display: flex; align-items: center; gap: var(--s-4); padding-block: var(--s-3) var(--s-6); font-size: var(--fs-caption); color: var(--text-muted); }
  .hero__track { position: relative; flex: 1; height: 1px; background: var(--line); overflow: hidden; }
  .hero__track span { position: absolute; inset-block: 0; inset-inline-start: 0; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); animation: track 1.4s var(--ease-out) 1.2s forwards; }
  :global([dir='rtl']) .hero__track span { transform-origin: right; }
  @keyframes track { to { transform: scaleX(0.24); } }

  @media (min-width: 768px) {
    .hero__art { height: 150px; }
    .hero__eyebrow { padding-inline-end: 140px; }
  }
  @media (min-width: 1024px) {
    .hero { padding-top: var(--s-6); }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; min-height: calc(100svh - 190px); padding-block: var(--s-4) var(--s-6); }
    .hero__copy { grid-column: 1 / span 8; grid-row: 1; align-self: center; }
    .hero__eyebrow { padding-inline-end: 0; }
    .hero__art { position: relative; top: auto; inset-inline-end: auto; grid-column: 9 / -1; grid-row: 1; align-self: stretch; height: auto; display: grid; place-items: center end; }
    .hero__mark { height: min(50vh, 480px); }
    /* the brand pattern, low and masked, as texture behind the mark only */
    .hero__field { display: block; position: absolute; inset: 8% -20% 8% 0; z-index: 0;
      -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent 100%); mask-image: radial-gradient(closest-side, #000 20%, transparent 100%); }
    :global([dir='rtl']) .hero__art { place-items: center start; }
    :global([dir='rtl']) .hero__field { inset: 8% 0 8% -20%; }
  }
  @media (min-width: 1024px) and (max-height: 820px) { .hero__mark { height: min(46vh, 380px); } }
  @media (max-height: 820px) {
    .hero { padding-top: var(--s-3); }
    .hero__copy { gap: var(--s-4); }
    .hero__grid { min-height: 0; padding-bottom: var(--s-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__track span { animation: none; transform: none; }
    :global(.js) .hero__mark :global(.logo__t), :global(.js) .hero__mark :global(.logo__blade) { opacity: 1 !important; transform: none !important; transition: none; }
  }
</style>
