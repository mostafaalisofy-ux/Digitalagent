---
import { SITE, type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { h } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = h(lang).contact;
---
<section class="final" aria-labelledby="final-title">
  <div class="final__img" aria-hidden="true"><img src="/visuals/cta-background.webp" srcset="/visuals/cta-background-1200.webp 1200w, /visuals/cta-background.webp 2352w" sizes="100vw" width="2352" height="952" alt="" loading="lazy" decoding="async" /></div>
  <div class="container final__in">
    <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span><span>{d.eyebrow}</span></p>
    <h2 class="final__title" id="final-title" data-reveal-group>{d.title.map((l, i) => <span class="line" style={`--delay:${i * 100}ms`}><span>{l}</span></span>)}</h2>
    <p class="final__body" data-reveal style="--delay:150ms">{d.body}</p>
    <div class="final__ctas" data-reveal style="--delay:250ms">
      <a class="btn btn--primary" href={href(lang, 'contact')} data-track="cta_click" data-cta-id="start_project" data-cta-location="final">{d.cta}<span class="arrow" aria-hidden="true"></span></a>
      <p class="final__or">{d.email} <a class="link-diag latin" href={`mailto:${SITE.email}`} data-track="email_click" data-cta-location="final">{SITE.email}</a></p>
    </div>
  </div>
</section>
<style>
  .final { position: relative; overflow: hidden; padding-block: var(--s-11); isolation: isolate; border-top: 1px solid var(--line); }
  /* illustrative background (decorative, AI-generated); its subject sits bottom-right, never mirrored */
  .final__img { position: absolute; z-index: -1; inset: 0; }
  .final__img img { width: 100%; height: 100%; object-fit: cover; object-position: 80% 100%; opacity: 0.7; }
  :global([dir='rtl']) .final__img img { opacity: 0.4; }
  .final__in { display: grid; gap: var(--s-5); }
  .final .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .final__title { font-size: var(--fs-h1); line-height: 1.05; letter-spacing: var(--track-tight); }
  .final__title .line { display: block; }
  :global([dir='rtl']) .final__title { line-height: 1.2; letter-spacing: 0; }
  .final__body { font-size: var(--fs-lead); color: var(--text); max-width: 44ch; }
  .final__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-6); margin-top: var(--s-3); }
  .final__or { color: var(--text-muted); font-size: var(--fs-small); }
  .final__or a { color: var(--text-strong); }
  @media (min-width: 1024px) { .final__title { font-size: clamp(3rem, 1.6rem + 3vw, 5rem); } }
  @media (max-width: 767px) { .final__img img { opacity: 0.4; object-position: 90% 100%; } }
</style>
