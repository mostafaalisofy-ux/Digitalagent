---
// "What we do": four pillars as editorial rows (not cards). Hover/focus slides the brand's
// diagonal element in from the row edge — the logo's own gesture as the interaction.
import SectionHead from '../SectionHead.astro';
import { SYMBOL } from '../../lib/logo';
import { PILLARS } from '../../data/services';
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).what;
const { x, y, w, h } = SYMBOL.bladeBox;
---
<section class="section caps" aria-labelledby="caps-title">
  <div class="container">
    <div class="caps__head">
      <SectionHead n="03" eyebrow={d.eyebrow} title={d.title} id="caps-title" size="h1" />
      <a class="link-diag caps__all" href={href(lang, 'services')}>{d.all}</a>
    </div>
    <ol role="list" class="caps__list">
      {PILLARS.map((p, i) => (
        <li class="cap" data-reveal style={`--delay:${i * 80}ms`}>
          <a class="cap__link" href={href(lang, 'services', p.id)}>
            <span class="num cap__n">{p.n}</span>
            <span class="cap__main">
              <span class="cap__name">{p.name[lang]}</span>
              <span class="cap__q">{p.question[lang]}</span>
            </span>
            <span class="cap__services">
              {p.services.map((s) => <span>{s.name[lang]}</span>)}
            </span>
            <svg class="cap__blade" viewBox={`${x} ${y} ${w} ${h}`} aria-hidden="true" focusable="false"><path d={SYMBOL.blade} /></svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .caps__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-5); margin-bottom: var(--s-8); }
  .caps__head :global(.sh) { flex: 1 1 560px; max-width: 980px; }
  .caps__list { border-top: 1px solid var(--line-strong); }
  .cap { border-bottom: 1px solid var(--line); }
  .cap__link { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: var(--s-2) var(--s-3); padding-block: var(--s-6); overflow: hidden; isolation: isolate; }
  .cap__n { font-size: var(--fs-caption); color: var(--accent-text); padding-top: 0.7em; }
  .cap__main { display: grid; gap: var(--s-2); }
  .cap__name { font-size: var(--fs-h1); font-weight: 700; line-height: 1; letter-spacing: var(--track-tight); color: var(--text-strong); transition: transform var(--d-3) var(--ease-out); }
  .cap__q { color: var(--text-muted); font-size: var(--fs-body); }
  .cap__services { grid-column: 2; display: flex; flex-wrap: wrap; gap: var(--s-2); padding-top: var(--s-3); }
  .cap__services span { font-size: var(--fs-caption); font-weight: 500; color: var(--text); padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-pill); }
  .cap__blade { position: absolute; z-index: -1; inset-block: -10%; inset-inline-end: -4%; height: 120%; width: auto; fill: var(--accent); opacity: 0; transform: translate3d(12%, -12%, 0); transition: opacity var(--d-3) var(--ease-out), transform var(--d-4) var(--ease-out); }
  [dir='rtl'] .cap__blade { transform: translate3d(-12%, -12%, 0) scaleX(1); }
  .cap__link:hover .cap__blade, .cap__link:focus-visible .cap__blade { opacity: 0.16; transform: none; }
  .cap__link:hover .cap__name, .cap__link:focus-visible .cap__name { transform: translateX(10px); }
  [dir='rtl'] .cap__link:hover .cap__name, [dir='rtl'] .cap__link:focus-visible .cap__name { transform: translateX(-10px); }
  @media (min-width: 1024px) {
    .cap__link { grid-template-columns: 80px minmax(0, 6fr) minmax(0, 4fr); align-items: center; padding-block: var(--s-7); }
    .cap__services { grid-column: 3; padding-top: 0; justify-content: flex-end; }
  }
</style>
