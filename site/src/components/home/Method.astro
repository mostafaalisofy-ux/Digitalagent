---
// The SayTamm Method: Say → Tamm → Prove. A diagonal progress line (blade angle) draws across.
import SectionHead from '../SectionHead.astro';
import { type Lang } from '../../config/site';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).method;
---
<section class="section section--surface method" id="method" aria-labelledby="method-title">
  <div class="container">
    <SectionHead n="06" eyebrow={d.eyebrow} title={d.title} id="method-title" size="display" />
    <ol role="list" class="steps" data-reveal-group>
      {d.steps.map((s, i) => (
        <li class="step" style={`--delay:${200 + i * 220}ms`}>
          <p class="step__k"><span class="num step__n">0{i + 1}</span><span class="step__word">{s.k}</span><span class:list={['step__alt', { latin: lang === 'ar' }]} lang={lang === 'ar' ? 'en' : 'ar'}>{s.ar}</span></p>
          <h3 class="step__t">{s.t}</h3>
          <p class="step__d">{s.d}</p>
          <p class="step__g">{s.g}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { position: relative; display: grid; gap: var(--s-8); margin-top: var(--s-9); }
  .step { position: relative; display: grid; gap: var(--s-3); padding-inline-start: var(--s-5); border-inline-start: 2px solid var(--line-strong); }
  .step::before { content: ''; position: absolute; inset-inline-start: -2px; top: 0; width: 2px; height: 0; background: var(--accent); transition: height var(--d-5) var(--ease-out); transition-delay: var(--delay); }
  .steps.is-in .step::before, :global(html:not(.js)) .step::before { height: 100%; }
  .step__k { display: flex; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .step__n { font-size: var(--fs-caption); color: var(--accent-text); }
  .step__word { font-size: var(--fs-display); font-weight: 700; line-height: 0.9; letter-spacing: var(--track-tight); color: var(--text-strong); }
  [dir='rtl'] .step__word { line-height: 1.15; }
  .step__alt { font-size: var(--fs-h3); color: var(--text-muted); font-weight: 500; }
  .step__alt:not(.latin) { font-family: var(--font-ar); }
  .step__t { font-size: var(--fs-h3); margin-top: var(--s-3); }
  .step__d { color: var(--text-muted); max-width: 36ch; }
  .step__g { font-weight: 700; color: var(--accent-text); font-size: var(--fs-small); margin-top: var(--s-2); }
  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); padding-top: var(--s-8); }
    .step { border-inline-start: 0; padding-inline-start: 0; padding-top: var(--s-7); }
    .step::before { display: none; }
    .step:nth-child(2) { margin-top: var(--s-9); } .step:nth-child(3) { margin-top: calc(var(--s-9) * 2); }
    /* one diagonal completion line across the three steps */
    .steps::before { content: ''; position: absolute; inset-inline-start: 0; top: var(--s-8); width: 100%; height: 3px; border-radius: 3px; background: var(--accent);
      transform-origin: left center; transform: rotate(9deg) scaleX(0); transition: transform var(--d-5) var(--ease-out) 200ms; }
    [dir='rtl'] .steps::before { transform-origin: right center; transform: rotate(-9deg) scaleX(0); }
    .steps.is-in::before { transform: rotate(9deg) scaleX(1); }
    [dir='rtl'] .steps.is-in::before { transform: rotate(-9deg) scaleX(1); }
  }
</style>
