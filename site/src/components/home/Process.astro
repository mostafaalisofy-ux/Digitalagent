---
// How we work: a real four-step sequence (so numbering is meaningful), with a completion line.
import { type Lang } from '../../config/site';
import { h } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = h(lang).process;
---
<section class="section section--surface proc" id="method" aria-labelledby="proc-title">
  <div class="container">
    <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
    <h2 class="proc__title" id="proc-title" data-reveal>{d.title}</h2>
    <ol role="list" class="proc__steps" data-reveal-group>
      {d.steps.map((s, i) => (
        <li class="ps" style={`--delay:${i * 140}ms`}>
          <span class="num latin ps__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="ps__t">{s.t}</h3>
          <p class="ps__d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .proc .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .proc__title { font-size: var(--fs-h1); letter-spacing: var(--track-tight); margin-top: var(--s-4); max-width: 22ch; }
  .proc__steps { display: grid; gap: var(--s-6); margin-top: var(--s-8); }
  .ps { position: relative; display: grid; gap: var(--s-3); padding-top: var(--s-5); border-top: 2px solid var(--line-strong); }
  .ps::before { content: ''; position: absolute; inset-inline-start: 0; top: -2px; height: 2px; width: 0; background: var(--accent); transition: width var(--d-5) var(--ease-out); transition-delay: var(--delay); }
  .proc__steps.is-in .ps::before, :global(html:not(.js)) .ps::before { width: 100%; }
  .ps__n { font-size: var(--fs-h2); font-weight: 700; color: var(--accent-text); line-height: 1; }
  .ps__t { font-size: var(--fs-h3); }
  .ps__d { color: var(--text-muted); }
  @media (min-width: 768px) { .proc__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); } }
  @media (min-width: 1024px) { .proc__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
