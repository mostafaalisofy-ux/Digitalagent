---
import { SYMBOL } from '../../lib/logo';
import { type Lang } from '../../config/site';
import { h } from '../../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = h(lang).why;
const { x, y, w, h: bh } = SYMBOL.bladeBox;
---
<section class="section why" aria-labelledby="why-title">
  <div class="container why__grid">
    <div class="why__head">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h2 class="why__title" id="why-title" data-reveal>{d.title}</h2>
    </div>
    <ul role="list" class="why__list">
      {d.points.map((p, i) => (
        <li class="wp" data-reveal style={`--delay:${i * 80}ms`}>
          <svg class="wp__mark" viewBox={`${x} ${y} ${w} ${bh}`} aria-hidden="true" focusable="false"><path d={SYMBOL.blade} /></svg>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .why .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .why__grid { display: grid; gap: var(--s-7); }
  .why__title { font-size: var(--fs-h1); letter-spacing: var(--track-tight); margin-top: var(--s-4); max-width: 16ch; }
  .why__list { display: grid; gap: var(--s-6); }
  .wp { display: grid; gap: var(--s-2); }
  .wp__mark { width: 18px; height: auto; fill: var(--accent); margin-bottom: var(--s-2); }
  .wp h3 { font-size: var(--fs-h3); }
  .wp p { color: var(--text-muted); max-width: 44ch; }
  @media (min-width: 768px) { .why__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--gutter); } }
  @media (min-width: 1024px) {
    .why__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--gutter); }
  }
</style>
