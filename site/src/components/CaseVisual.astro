---
// Case visual frame. Until original campaign assets arrive (OQ-32) it renders a clearly
// labelled placeholder built from the brand pattern — never stock imagery.
import Pattern from './Pattern.astro';
interface Props { id: string; label: string; kpi?: string; ratio?: string; src?: string | null; alt?: string }
const { id, label, kpi, ratio = '4 / 3', src = null, alt = '' } = Astro.props;
---
<figure class="cv" style={`aspect-ratio:${ratio}`} data-reveal="wipe">
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : (
    <>
      <Pattern id={`pat-${id}`} opacity={0.22} size={18} />
      {kpi && <span class="cv__kpi num latin" aria-hidden="true">{kpi}</span>}
      <figcaption class="placeholder-tag cv__tag">{label}</figcaption>
    </>
  )}
</figure>
<style>
  .cv { position: relative; overflow: hidden; background: var(--c-graphite); margin: 0; }
  .cv img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--d-5) var(--ease-out); }
  :global(a:hover) .cv img { transform: scale(1.03); }
  .cv__kpi { position: absolute; inset-inline-start: 6%; bottom: 4%; font-size: clamp(4rem, 3rem + 7vw, 11rem); font-weight: 700; line-height: 0.85; color: var(--c-white); opacity: 0.06; letter-spacing: -0.05em; }
  .cv__tag { position: absolute; inset-inline-start: var(--s-4); top: var(--s-4); background: rgb(10 10 13 / 0.7); }
</style>
