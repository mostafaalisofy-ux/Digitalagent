---
// Case visuals. Real campaign assets only (W-014). A case without supplied visuals gets a
// to-scale data composition (spend vs result) — never stock, AI or mock imagery.
import type { Case } from '../../data/cases';
import { showFigures } from '../../data/cases';
import { SYMBOL } from '../../lib/logo';
import type { Lang } from '../../config/site';
import { h } from '../../i18n/home';
interface Props { c: Case; lang: Lang; size?: 'chapter' | 'page' }
const { c, lang, size = 'chapter' } = Astro.props;
const d = h(lang).selected;
const fmt = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(2)}M` : `${Math.round(n / 1e3)}K`);
const kind = c.visual ? c.visual.kind : c.bar && showFigures(c) ? 'data' : null;
const { x, y, w: bw, h: bh } = SYMBOL.bladeBox;
---
{kind === 'photo' && (
  <figure class:list={['media photos', `media--${size}`]}>
    {c.visual!.images.map((im, k) => (
      <div class={`photos__item photos__item--${k}`} data-reveal="wipe" style={`--delay:${k * 140}ms`}>
        <img src={im.src} width={im.w} height={im.h} alt={im.alt[lang]} loading="lazy" decoding="async" />
      </div>
    ))}
    <figcaption class="media__cap">{c.visual!.caption[lang]}</figcaption>
  </figure>
)}
{kind === 'screen' && (
  <figure class:list={['media screens', `media--${size}`]}>
    <div class="screens__desk" data-reveal="wipe"><img src={c.visual!.images[0].src} width={c.visual!.images[0].w} height={c.visual!.images[0].h} alt={c.visual!.images[0].alt[lang]} loading="lazy" decoding="async" /></div>
    {c.visual!.images[1] && <div class="screens__phone" data-reveal style="--delay:220ms"><img src={c.visual!.images[1].src} width={c.visual!.images[1].w} height={c.visual!.images[1].h} alt={c.visual!.images[1].alt[lang]} loading="lazy" decoding="async" /></div>}
    <figcaption class="media__cap">{c.visual!.caption[lang]}</figcaption>
  </figure>
)}
{kind === 'data' && c.bar && (
  <figure class:list={['media data', `media--${size}`]}>
    <svg class="data__blade" viewBox={`${x} ${y} ${bw} ${bh}`} aria-hidden="true" focusable="false"><path d={SYMBOL.blade} /></svg>
    <p class="data__giant num latin"><span>{fmt(c.bar.result)}</span><span class="data__unit">{c.bar.unit[lang]}</span></p>
    <p class="data__sub">{c.bar.resultLabel[lang]}</p>
    <div class="data__bars" data-reveal-group>
      <div class="bar2"><span class="bar2__k">{c.bar.spendLabel[lang]}</span><span class="bar2__track"><span class="bar2__fill bar2__fill--spend" style={`--w:${(c.bar.spend / c.bar.result) * 100}%`}></span></span><bdi class="bar2__v num latin">{fmt(c.bar.spend)} {c.bar.unit[lang]}</bdi></div>
      <div class="bar2"><span class="bar2__k">{c.bar.resultLabel[lang]}</span><span class="bar2__track"><span class="bar2__fill bar2__fill--result" style="--w:100%"></span></span><bdi class="bar2__v num latin">{fmt(c.bar.result)} {c.bar.unit[lang]}</bdi></div>
    </div>
    <figcaption class="media__cap">{d.dataCaption}</figcaption>
  </figure>
)}
<style>
  .media { margin: 0; min-width: 0; }
  .media__cap { margin-top: var(--s-3); font-size: var(--fs-caption); color: var(--text-muted); max-width: 60ch; }

  .photos { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: var(--s-3); align-items: start; }
  .photos__item { overflow: hidden; background: var(--surface); }
  .photos__item img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 2 / 3; transition: transform var(--d-5) var(--ease-out); }
  .photos__item--1 { margin-top: var(--s-9); }
  .photos__item--2 { margin-top: var(--s-5); }
  .photos .media__cap { grid-column: 1 / -1; }
  .photos:hover .photos__item img { transform: scale(1.02); }

  .screens { position: relative; padding-bottom: var(--s-6); }
  .screens__desk { background: #000; overflow: hidden; }
  .screens__desk img { width: 100%; height: auto; }
  .screens__phone { position: absolute; inset-inline-end: -2%; bottom: var(--s-6); width: 24%; filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.55)); }
  .screens__phone img { width: 100%; height: auto; }

  .data { position: relative; overflow: hidden; background: var(--surface); padding: var(--s-7) var(--s-6) var(--s-5); min-height: 420px; display: grid; align-content: end; gap: var(--s-4); isolation: isolate; }
  .data__blade { position: absolute; z-index: -1; inset-inline-end: -10%; top: -20%; height: 150%; width: auto; fill: var(--bg); opacity: 0.7; }
  .data__giant { display: flex; align-items: baseline; gap: 0.08em; font-size: clamp(4.25rem, 2rem + 8vw, 10rem); font-weight: 700; line-height: 0.85; letter-spacing: -0.06em; color: var(--text-strong); }
  :global([dir='rtl']) .data__giant { justify-content: flex-start; }
  .data__unit { font-size: 0.22em; letter-spacing: 0; color: var(--text-muted); font-weight: 500; }
  .data__sub { font-size: var(--fs-small); color: var(--text-muted); }
  .data__bars { display: grid; gap: var(--s-3); margin-top: var(--s-3); }
  .bar2 { display: grid; grid-template-columns: 8.5em 1fr auto; align-items: center; gap: var(--s-3); font-size: var(--fs-caption); }
  .bar2__k { color: var(--text-muted); }
  .bar2__track { position: relative; height: 10px; background: rgb(245 243 250 / 0.06); }
  .bar2__fill { position: absolute; inset-block: 0; inset-inline-start: 0; width: var(--w); min-width: 3px; transform-origin: left; transform: scaleX(0); transition: transform var(--d-5) var(--ease-out); }
  :global([dir='rtl']) .bar2__fill { transform-origin: right; }
  .bar2__fill--spend { background: var(--text-muted); }
  .bar2__fill--result { background: var(--accent); transition-delay: 220ms; }
  .data__bars:global(.is-in) .bar2__fill, :global(html:not(.js)) .bar2__fill { transform: none; }
  .bar2__v { font-weight: 700; color: var(--text-strong); }

  @media (max-width: 767px) {
    .photos { grid-template-columns: 1fr 1fr; }
    .photos__item--0 { grid-column: 1 / -1; }
    .photos__item--0 img { aspect-ratio: 4 / 5; }
    .photos__item--1 { margin-top: 0; }
    .photos__item--2 { margin-top: var(--s-6); }
    .screens__phone { width: 30%; }
    .data { min-height: 320px; padding: var(--s-6) var(--s-4) var(--s-4); }
    .bar2 { grid-template-columns: 6.5em 1fr auto; }
  }
  @media (prefers-reduced-motion: reduce) { .bar2__fill { transform: none !important; } }
</style>
