---
// v1.0 close: the markets skyline (no words), the brief CTA and Tamm welcoming.
import { SITE, type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { h } from '../../i18n/home';
import { v1 } from '../../i18n/v1';
import { V1, v1src } from '../../data/v1assets';
import Skyline from './Skyline.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = v1(lang).end; const cta = h(lang).contact;
const [w, hh] = V1['tamm_welcomecard'];
---
<section class="section end" aria-labelledby="end-title">
  <div class="container end__grid">
    <div class="end__copy">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{c.eyebrow}</p>
      <h2 class="end__title" id="end-title" data-reveal-group>{c.title.map((l, i) => <span class={`line${i ? ' end__accent' : ''}`} style={`--delay:${i * 100}ms`}><span>{l}</span></span>)}</h2>
      <p class="end__body" data-reveal>{c.body}</p>
      <div class="end__ctas" data-reveal>
        <a class="btn btn--primary" href={href(lang, 'contact')} data-track="cta_click" data-cta-id="start_project" data-cta-location="final">{cta.cta}<span class="arrow" aria-hidden="true"></span></a>
        <p class="end__or">{c.email} <a class="link-diag latin" href={`mailto:${SITE.email}`} data-track="email_click" data-cta-location="final">{SITE.email}</a></p>
      </div>
    </div>
    <figure class="end__tamm" data-reveal="mask"><img src={v1src('tamm_welcomecard')} width={w} height={hh} alt="" loading="lazy" decoding="async" /></figure>
  </div>
  <div class="container end__sky" data-reveal-group><Skyline label={c.sky} /></div>
</section>
<style>
  .end { border-top: 1px solid var(--line); padding-bottom: 0; }
  .end__grid { display: grid; gap: var(--s-6); align-items: end; }
  .end__copy { display: grid; gap: var(--s-5); }
  .end .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .end__title { font-size: clamp(2.6rem, 1.4rem + 3.6vw, 5rem); line-height: 1.02; letter-spacing: var(--track-tight); }
  .end__title .line { display: block; }
  .end__accent { color: var(--accent); }
  :global([dir='rtl']) .end__title { letter-spacing: 0; line-height: 1.2; }
  .end__body { color: var(--text-muted); max-width: 48ch; font-size: var(--fs-lead); }
  .end__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-6); }
  .end__or { color: var(--text-muted); font-size: var(--fs-small); }
  .end__or a { color: var(--text-strong); }
  .end__tamm { margin: 0; border-radius: 14px; overflow: hidden; max-width: 340px; justify-self: end; background: var(--surface); }
  .end__tamm img { display: block; width: 100%; height: auto; }
  .end__sky { margin-top: var(--s-7, 72px); max-width: 1100px; }
  @media (min-width: 1024px) {
    .end__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .end__copy { grid-column: 1 / span 8; }
    .end__tamm { grid-column: 9 / -1; }
  }
  @media (max-width: 767px) { .end__tamm { max-width: 240px; } }
</style>
