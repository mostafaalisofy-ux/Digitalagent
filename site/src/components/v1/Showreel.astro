---
// v1.1 showreel band: «قولها… تمّت» (16:9, real client work), muted on loop while it is on screen, with a sound toggle.
// The frame is cut at 45° on two corners, like the blade.
import { type Lang } from '../../config/site';
import { v1 } from '../../i18n/v1';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = v1(lang).motion;
---
<section class="section reel" aria-labelledby="reel-title">
  <div class="container">
    <header class="reel__head">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{m.reel}</p>
      <h2 class="reel__title" id="reel-title" data-reveal>{m.reelTitle}</h2>
    </header>
    <div class="reel__film" data-reveal>
      <video class="js-inview" muted loop playsinline preload="metadata" poster={`/media/showreel-${lang}.jpg`} src={`/media/showreel-${lang}.mp4`} aria-label={m.reelTitle}></video>
      <button class="reel__sound" type="button" data-on={m.soundOn} data-off={m.soundOff} aria-pressed="false">
        <span class="reel__ico" aria-hidden="true"></span><span class="reel__lbl">{m.soundOn}</span>
      </button>
    </div>
    <p class="reel__note" data-reveal>{m.reelNote}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.reel__sound').forEach((b) => {
    const v = b.parentElement!.querySelector('video')!; const lbl = b.querySelector('.reel__lbl')!;
    b.addEventListener('click', () => {
      v.muted = !v.muted; if (!v.muted) { v.currentTime = 0; v.play(); }
      b.setAttribute('aria-pressed', String(!v.muted)); lbl.textContent = v.muted ? b.dataset.on! : b.dataset.off!;
    });
  });
</script>

<style>
  .reel__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .reel .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .reel__title { font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: var(--track-tight); max-width: 16ch; }
  .reel__film { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; border-radius: 20px;
    clip-path: polygon(0 0, calc(100% - 64px) 0, 100% 64px, 100% 100%, 64px 100%, 0 calc(100% - 64px)); }
  .reel__film video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reel__sound { position: absolute; inset-block-end: 18px; inset-inline-start: 18px; display: inline-flex; align-items: center; gap: 10px; min-height: 44px;
    padding: 0 18px; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(9 9 13 / .72); color: var(--text-strong);
    font: 700 var(--fs-small) / 1 var(--font); cursor: pointer; backdrop-filter: blur(8px); }
  :global([dir='rtl']) .reel__sound { inset-inline-start: auto; inset-inline-end: 18px; }
  .reel__sound:hover { border-color: var(--text-muted); }
  .reel__ico { width: 10px; height: 10px; border-radius: 2px; background: var(--accent); transform: rotate(45deg); }
  .reel__sound[aria-pressed='true'] .reel__ico { background: var(--text-strong); }
  .reel__note { margin-top: var(--s-4); color: var(--text-muted); font-size: var(--fs-caption); }
  @media (max-width: 767px) { .reel__film { clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 28px 100%, 0 calc(100% - 28px)); border-radius: 12px; } }
</style>
