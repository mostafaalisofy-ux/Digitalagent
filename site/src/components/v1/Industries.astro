---
// v1.0: the work, by industry (as the 2026 profile). Tabs need a few lines of script; without it every industry
// is shown in turn, so nothing is hidden from people or search engines.
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { v1, INDUSTRIES } from '../../i18n/v1';
import { V1, v1src } from '../../data/v1assets';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = v1(lang).work;
---
<section class="section ind" aria-labelledby="ind-title">
  <div class="container">
    <div class="ind__head">
      <div>
        <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{c.eyebrow}</p>
        <h2 class="ind__title" id="ind-title" data-reveal>{c.title}</h2>
      </div>
      <a class="link-diag" href={href(lang, 'work')} data-reveal>{c.all}</a>
    </div>
    <div class="ind__tabs" role="tablist" aria-label={c.tabs} data-reveal>
      {INDUSTRIES.map((x, i) => (
        <button class="ind__tab" role="tab" type="button" id={`tab-${x.id}`} aria-controls={`panel-${x.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="latin ind__n">{String(i + 1).padStart(2, '0')}</span>{x.name[lang]}
        </button>
      ))}
    </div>
    {INDUSTRIES.map((x, i) => (
      <div class={`ind__panel ind--${x.layout}`} role="tabpanel" id={`panel-${x.id}`} aria-labelledby={`tab-${x.id}`} data-first={i === 0 ? '' : undefined}>
        <div class="ind__text">
          <h3>{x.name[lang]}</h3>
          <p class="ind__made">{x.made[lang]}</p>
          <p class="ind__desc">{x.desc[lang]}</p>
          <p class="ind__brands latin">{x.brands}</p>
        </div>
        <div class="ind__imgs">
          {x.images.map((m) => <figure><img src={v1src(m)} width={V1[m][0]} height={V1[m][1]} alt={`${x.brands} — ${x.made[lang]}`} loading="lazy" decoding="async" /></figure>)}
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('.ind')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ind__tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.ind__panel')];
    root.classList.add('is-tabbed');
    const show = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const rtl = document.documentElement.dir === 'rtl';
        const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1, Home: -i, End: tabs.length - 1 - i }[e.key];
        if (next === undefined) return;
        e.preventDefault(); show((i + next + tabs.length) % tabs.length, true);
      });
    });
    show(0);
  }
</script>
<style>
  .ind__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4); margin-bottom: var(--s-6); }
  .ind .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .ind__title { font-size: var(--fs-h1); line-height: 1.05; letter-spacing: var(--track-tight); margin-top: var(--s-3); }
  :global([dir='rtl']) .ind__title { letter-spacing: 0; line-height: 1.25; }
  .ind__tabs { display: none; gap: var(--s-2); overflow-x: auto; scrollbar-width: none; padding-bottom: var(--s-2); margin-bottom: var(--s-5); border-bottom: 1px solid var(--line); }
  .ind.is-tabbed .ind__tabs { display: flex; }
  .ind__tab { flex: none; display: inline-flex; gap: 10px; align-items: baseline; padding: 12px 18px; border-radius: 999px; border: 1px solid var(--line); background: none; color: var(--text-muted);
    font: inherit; font-size: var(--fs-small); font-weight: 500; cursor: pointer; transition: color var(--d-2), border-color var(--d-2), background var(--d-2); }
  .ind__tab:hover { color: var(--text-strong); border-color: var(--line-strong); }
  .ind__tab[aria-selected='true'] { color: var(--text-strong); border-color: var(--text-strong); }
  .ind__n { font-size: 0.75rem; color: var(--accent-text); font-weight: 700; }
  .ind__panel { display: grid; gap: var(--s-5); padding-block: var(--s-5); }
  .ind:not(.is-tabbed) .ind__panel + .ind__panel { border-top: 1px solid var(--line); }
  .ind__panel[hidden] { display: none; }
  .ind__text { display: grid; gap: var(--s-3); align-content: start; }
  .ind__text h3 { font-size: var(--fs-h2); line-height: 1.08; }
  .ind__made { color: var(--accent-text); font-weight: 700; font-size: var(--fs-small); }
  .ind__desc { color: var(--text-muted); max-width: 40ch; }
  .ind__brands { font-size: var(--fs-caption); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; border-top: 1px solid var(--line); padding-top: var(--s-3); }
  .ind__imgs { display: grid; gap: 10px; }
  .ind__imgs figure { margin: 0; overflow: hidden; border-radius: 10px; background: var(--surface); min-height: 0; }
  .ind__imgs img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ind--tri .ind__imgs { grid-template-columns: repeat(3, 1fr); }
  .ind--tri .ind__imgs figure { aspect-ratio: 9 / 16; }
  .ind--mix .ind__imgs { grid-template-columns: 1fr 1.3fr; grid-template-rows: repeat(2, minmax(0, 1fr)); aspect-ratio: 4 / 3.4; }
  .ind--mix .ind__imgs figure:first-child { grid-row: span 2; }
  .ind--ge .ind__imgs { grid-template-columns: repeat(4, 1fr); }
  .ind--ge .ind__imgs figure { aspect-ratio: 1; }
  .ind--ge .ind__imgs figure:first-child { grid-column: span 2; grid-row: span 2; }
  .ind--gf .ind__imgs { grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .ind--gf .ind__imgs figure { aspect-ratio: 4 / 5; }
  .ind--gf .ind__imgs figure:first-child { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .ind--gf .ind__imgs figure:nth-child(2) { grid-column: span 2; aspect-ratio: auto; }
  @media (min-width: 1024px) {
    .ind__panel { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: stretch; min-height: 560px; }
    .ind__text { grid-column: 1 / span 4; }
    .ind__desc { margin-top: auto; }
    .ind__imgs { grid-column: 5 / -1; }
    .ind--tri .ind__imgs figure { aspect-ratio: auto; height: 560px; }
    .ind--mix .ind__imgs { aspect-ratio: auto; height: 560px; }
  }
  @media (max-width: 767px) {
    .ind--gf .ind__imgs { grid-template-columns: repeat(3, 1fr); }
    .ind--gf .ind__imgs figure:nth-child(2) { grid-column: span 1; aspect-ratio: 4 / 5; }
    .ind--ge .ind__imgs { grid-template-columns: repeat(3, 1fr); }
    .ind--ge .ind__imgs figure:first-child { grid-column: span 3; grid-row: auto; }
  }
</style>
