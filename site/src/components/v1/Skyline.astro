  <circle class="pin" cx="640" cy="8" r="5"/>
  <circle class="pin" cx="900" cy="-26" r="5"/>
</svg>
<style>
  .sky { display: block; width: 100%; height: auto; overflow: visible; direction: ltr; }
  .lm { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: .8; }
  .f { fill: var(--bg); }
  .rt { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 3 6; opacity: .65; vector-effect: non-scaling-stroke; }
  .pin { fill: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sky .lm, :global(.js) .sky .rt { stroke-dasharray: 3000; stroke-dashoffset: 3000; transition: stroke-dashoffset 2.4s var(--ease-out); }
    :global(.js) .sky .rt { stroke-dasharray: 3 6; stroke-dashoffset: 0; opacity: 0; transition: opacity 1s 1.6s; }
    :global(.js) .sky .pin { opacity: 0; transition: opacity .5s 2s; }
    :global(.js) .is-in .sky .lm { stroke-dashoffset: 0; }
    :global(.js) .is-in .sky .rt { opacity: .65; }
    :global(.js) .is-in .sky .pin { opacity: 1; }
  }
</style>
