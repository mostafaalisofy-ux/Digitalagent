  <path class="lm" d="M470,240 L475,92 M490,240 L485,92 M474.0,92 L485.4,110 M474.6,110 L484.8,128 M475.2,128 L484.2,146 M475.8,146 L483.6,164 M476.4,164 L483.0,182 M477.0,182 L482.4,200 M477.6,200 L481.7,218 M478.3,218 L481.1,236 M475,92 L464,72 L496,72 L485,92 M462,72 V60 H498 V72 M480,60 V30"/>
  <path class="lm" d="M598,240 V118 Q598,64 613,24 Q640,182 667,24 Q682,64 682,118 V240 M619,56 H661 M619,63 H661 M612,150 H668 M612,190 H668"/>
