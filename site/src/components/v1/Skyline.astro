---
// Markets skyline (Egypt: Giza pyramids, Cairo Tower · Saudi Arabia: Kingdom Centre, Al Faisaliah · UAE: Burj Khalifa,
// Burj Al Arab, Dubai Frame). Line art drawn for SayTamm (same geometry as the company profile); no words, no flags.
// Generated once from docs/profile/build_profile_pptx.py → sky_paths(). Never mirrored in RTL.
interface Props { class?: string; label?: string }
const { class: cls = '', label } = Astro.props;
---
<svg class={`sky ${cls}`} viewBox="0 -50 1200 296" preserveAspectRatio="xMidYMax meet" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <path class="lm f" d="M372,240 L404,198 L436,240 Z"/>
  <path class="lm" d="M404,198 L410,240"/>
  <path class="lm f" d="M238,240 L312,156 L386,240 Z"/>
  <path class="lm" d="M312,156 L330,240"/>
  <path class="lm f" d="M40,240 L150,118 L262,240 Z"/>
