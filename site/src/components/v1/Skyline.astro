  <ellipse class="lm" cx="740" cy="80" rx="10" ry="10"/>
  <path class="lm" d="M860,240 L860,204 L868,204 L868,166 L875,166 L875,128 L882,128 L882,92 L888,92 L888,60 L893,60 L893,34 L897,34 L900,-6 L900,-6 L903,34 L907,34 L907,60 L912,60 L912,92 L918,92 L918,128 L925,128 L925,166 L932,166 L932,204 L940,204 L940,240"/>
  <path class="lm" d="M986,240 V40 M990,50 Q1074,96 1052,240 M990,50 V240 M992,79 L1025,79 M992,111 L1044,111 M992,151 L1054,151 M992,191 L1056,191 M986,74 H968"/>
