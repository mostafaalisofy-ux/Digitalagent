---
// v1.0 hero (owner 2026-11-26): a full-bleed studio scene of Tamm leaning on the purple 45° blade (owner-generated
// key visual, no text in the image). The website copy is real HTML over the empty side of the scene.
// English: Tamm on the right, copy on the left. Arabic: a separate render with Tamm on the left (never a mirrored
// image, so the "T" on Tamm reads correctly), copy on the right. Phone: portrait render, Tamm above, copy below.
import { type Lang } from '../../config/site';
import { href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
import { v1 } from '../../i18n/v1';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero; const c = v1(lang);
const desk = lang === 'ar' ? '/v1/hero_tamm_ar.webp' : '/v1/hero_tamm_en.webp';
---
<section class="vh" aria-labelledby="vh-title">
  <picture class="vh__bg">
    <source media="(max-width: 767px)" srcset="/v1/hero_tamm_m.webp" width="1024" height="1536" />
    <img src={desk} width="1672" height="941" alt={c.tammAlt} decoding="async" fetchpriority="high" />
  </picture>
  <div class="container vh__in">
    <div class="vh__copy">
      <p class="eyebrow" data-reveal style="--delay:80ms"><span class="t-rule" aria-hidden="true"></span>{d.eyebrow}</p>
      <h1 class="vh__title" id="vh-title" data-reveal-group>
        <span class="line" style="--delay:160ms"><span>{d.l1}</span></span>
        <span class="line vh__accent" style="--delay:280ms"><span>{d.l2}</span></span>
      </h1>
      <p class="vh__sub" data-reveal style="--delay:460ms">{d.sub}</p>
      <div class="vh__ctas" data-reveal style="--delay:560ms">
        <a class="btn btn--primary" href={href(lang, 'contact')} data-track="cta_click" data-cta-id="start_project" data-cta-location="hero">{d.cta}<span class="arrow" aria-hidden="true"></span></a>
        <a class="link-diag" href={href(lang, 'work')} data-track="cta_click" data-cta-id="explore_work" data-cta-location="hero">{d.cta2}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .vh { position: relative; overflow: hidden; isolation: isolate; background: #0b0a10; min-height: min(calc(100svh - 110px), 900px); display: grid; align-items: center; }
  .vh__bg { position: absolute; inset: 0; z-index: -1; }
  .vh__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 100% 60%; }
  :global([dir='rtl']) .vh__bg img { object-position: 0% 60%; }
  /* keeps the copy side calm on very wide or short screens where the scene is cropped */
  .vh::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgb(11 10 16 / .55) 0%, rgb(11 10 16 / .15) 45%, transparent 60%); }
  :global([dir='rtl']) .vh::after { background: linear-gradient(270deg, rgb(11 10 16 / .55) 0%, rgb(11 10 16 / .15) 45%, transparent 60%); }
  .vh__in { padding-block: var(--s-7, 72px); }
  .vh__copy { display: grid; gap: var(--s-5); max-width: min(40rem, 52%); }
  .vh .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .vh__title { font-size: min(var(--fs-mega), 15vh); line-height: .88; letter-spacing: -0.05em; font-weight: 700; }
  .vh__title .line { display: block; }
  .vh__accent { color: var(--accent); }
  :global([dir='rtl']) .vh__title { line-height: 1.05; letter-spacing: 0; font-size: min(var(--fs-mega), 12vh); }
  .vh__sub { font-size: var(--fs-lead); max-width: 36ch; line-height: 1.5; }
  .vh__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); }
  /* phone: portrait scene, Tamm in the top half, the copy on the dark floor below */
  @media (max-width: 767px) {
    .vh { min-height: 0; align-items: end; }
    .vh__bg img { object-position: 50% 0%; }
    :global([dir='rtl']) .vh__bg img { object-position: 50% 0%; }
    .vh::after { background: linear-gradient(180deg, transparent 52%, rgb(11 10 16 / .7) 68%); }
    :global([dir='rtl']) .vh::after { background: linear-gradient(180deg, transparent 52%, rgb(11 10 16 / .7) 68%); }
    .vh__in { padding-top: 118vw; padding-bottom: var(--s-6); }
    .vh__copy { max-width: none; gap: var(--s-4); }
    .vh__title { font-size: clamp(3.2rem, 15vw, 5.5rem); }
  }
  @media (min-width: 768px) and (max-width: 1023px) { .vh__copy { max-width: 58%; } .vh__title { font-size: clamp(3.4rem, 9vw, 6rem); } }
</style>
