---
// v1.0: the three published case studies (D-025/D-026), each with its figure and how it was measured.
import { type Lang } from '../../config/site';
import { caseHref } from '../../i18n/paths';
import { v1 } from '../../i18n/v1';
import { getCase } from '../../data/cases';
import { V1, v1src } from '../../data/v1assets';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = v1(lang).cases;
const SHOW: [string, string][] = [['ks-furniture', 'stk_ks_cushion'], ['fashion-beauty-scale', 'stk_cs_unbox'], ['electronics-q4', 'stk_cs_shop']];
---
<section class="section cs" aria-labelledby="cs-title">
  <div class="container">
    <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{c.eyebrow}</p>
    <h2 class="cs__title" id="cs-title" data-reveal>{c.title}</h2>
    <p class="cs__lead" data-reveal>{c.body}</p>
    <div class="cs__grid">
      {SHOW.map(([slug, pic], i) => {
        const k = getCase(slug); const top = k.kpis[0];
        return (
          <article class="cs__card" data-reveal style={`--delay:${i * 90}ms`}>
            <img src={v1src(pic)} width={V1[pic][0]} height={V1[pic][1]} alt="" loading="lazy" decoding="async" />
            <div class="cs__body">
              <p class="cs__meta">{k.sector[lang]}{k.period ? <> · <bdi>{k.period[lang]}</bdi></> : null}</p>
              <p class="cs__fig latin"><bdi>{top.value}</bdi></p>
              <p class="cs__lab">{top.label[lang]}</p>
              <h3>{k.client[lang]}</h3>
              <p class="cs__head">{k.headline[lang]}</p>
              <p class="cs__how"><span>{c.measured}: </span>{k.evidence.measured[lang]}</p>
              <a class="link-diag cs__link" href={caseHref(lang, slug)}>{c.read}</a>
            </div>
          </article>
        );
      })}
    </div>
    <p class="cs__note">{c.photo}</p>
  </div>
</section>
<style>
  .cs .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .cs__title { font-size: var(--fs-h1); line-height: 1.05; letter-spacing: var(--track-tight); margin-top: var(--s-3); }
  :global([dir='rtl']) .cs__title { letter-spacing: 0; line-height: 1.25; }
  .cs__lead { color: var(--text-muted); max-width: 56ch; margin-top: var(--s-3); }
  .cs__grid { display: grid; gap: var(--s-4); margin-top: var(--s-6); }
  .cs__card { background: var(--surface); border-radius: 14px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .cs__card img { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; display: block; filter: saturate(.85); }
  .cs__body { padding: var(--s-5); display: grid; gap: var(--s-2); align-content: start; }
  .cs__meta { font-size: var(--fs-caption); color: var(--text-muted); letter-spacing: .06em; text-transform: uppercase; font-weight: 700; }
  .cs__fig { font-size: clamp(2.8rem, 1.8rem + 3vw, 4.4rem); font-weight: 700; line-height: 1; letter-spacing: -0.04em; margin-top: var(--s-2); }
  .cs__card:first-child .cs__fig { color: var(--accent); }
  .cs__lab { color: var(--accent-text); font-weight: 700; font-size: var(--fs-small); }
  .cs__card h3 { font-size: var(--fs-h3); margin-top: var(--s-3); }
  .cs__head { color: var(--text); }
  .cs__how { font-size: var(--fs-caption); color: var(--text-muted); border-top: 1px solid var(--line); padding-top: var(--s-3); margin-top: var(--s-2); line-height: 1.5; }
  .cs__how span { font-weight: 700; }
  .cs__link { justify-self: start; margin-top: var(--s-3); font-size: var(--fs-small); }
  .cs__note { margin-top: var(--s-4); font-size: var(--fs-caption); color: var(--text-muted); }
  @media (min-width: 1024px) { .cs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
