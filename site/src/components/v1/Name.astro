---
// v1.0: what «قول تم» means, Tamm (character card), and the approved facts.
import { type Lang } from '../../config/site';
import { v1 } from '../../i18n/v1';
import { V1, v1src } from '../../data/v1assets';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = v1(lang).name; const facts = v1(lang).facts;
const [w, h] = V1['tamm_capcard'];
---
<section class="section nm" aria-labelledby="nm-title">
  <div class="container nm__grid">
    <div class="nm__copy">
      <p class="eyebrow" data-reveal><span class="t-rule" aria-hidden="true"></span>{c.eyebrow}</p>
      <h2 class="nm__title" id="nm-title" data-reveal-group>{c.title.map((l, i) => <span class="line" style={`--delay:${i * 100}ms`}><span>{l}</span></span>)}</h2>
      <div class="nm__name" data-reveal>
        <span class="nm__ar" lang="ar" dir="rtl">قول تم</span>
        <p>{c.body}</p>
      </div>
    </div>
    <figure class="nm__card" data-reveal="mask">
      <img src={v1src('tamm_capcard')} width={w} height={h} alt="" loading="lazy" decoding="async" />
      <figcaption>{c.card}</figcaption>
    </figure>
  </div>
  <div class="container">
    <dl class="nm__facts">
      {facts.map(([v, k], i) => (
        <div data-reveal style={`--delay:${i * 60}ms`}><dt class="latin">{v}</dt><dd>{k}</dd></div>
      ))}
    </dl>
  </div>
</section>
<style>
  .nm__grid { display: grid; gap: var(--s-6); align-items: end; }
  .nm__copy { display: grid; gap: var(--s-5); }
  .nm .eyebrow .t-rule { color: var(--accent); width: 32px; height: 4px; }
  .nm__title { font-size: var(--fs-display); line-height: 1; letter-spacing: var(--track-tight); }
  .nm__title .line { display: block; }
  :global([dir='rtl']) .nm__title { line-height: 1.2; letter-spacing: 0; }
  .nm__name { display: grid; grid-template-columns: auto 1fr; gap: var(--s-5); align-items: center; border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .nm__ar { font-family: var(--font-ar); font-weight: 700; color: var(--accent); font-size: clamp(2.6rem, 1.8rem + 3vw, 4.4rem); line-height: 1; }
  .nm__name p { color: var(--text-muted); max-width: 46ch; font-size: var(--fs-lead); line-height: 1.55; }
  .nm__card { position: relative; margin: 0; border-radius: 14px; overflow: hidden; background: var(--surface); max-width: 420px; justify-self: end; }
  .nm__card img { display: block; width: 100%; height: auto; }
  .nm__card figcaption { position: absolute; inset-inline: 0; bottom: 0; padding: 48px 20px 18px; font-size: var(--fs-small); background: linear-gradient(transparent, rgb(9 9 13 / .92)); }
  .nm__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); margin: var(--s-8, 96px) 0 0; }
  .nm__facts div { border-top: 1px solid var(--line); padding-top: var(--s-3); display: grid; gap: var(--s-2); }
  .nm__facts dt { font-size: clamp(2.6rem, 1.6rem + 3.6vw, 5rem); font-weight: 700; line-height: .9; letter-spacing: -0.04em; }
  .nm__facts div:first-child dt { color: var(--accent); }
  .nm__facts dd { margin: 0; color: var(--text-muted); font-size: var(--fs-small); max-width: 22ch; }
  @media (min-width: 768px) { .nm__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .nm__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .nm__copy { grid-column: 1 / span 8; }
    .nm__card { grid-column: 9 / -1; }
    .nm__facts { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) { .nm__name { grid-template-columns: 1fr; } .nm__card { justify-self: stretch; max-width: none; } }
</style>
