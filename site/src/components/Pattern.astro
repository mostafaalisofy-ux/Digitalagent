---
// Brand pattern: the diagonal completion element ALONE (never the full logo), brick-offset,
// one size per tile, one colour per instance, 8–18% opacity behind content (VISUAL_IDENTITY §4).
import { SYMBOL } from '../lib/logo';
interface Props { id: string; color?: string; opacity?: number; size?: number; gap?: number; class?: string }
const { id, color = '#6C35FF', opacity = 0.12, size = 26, gap = 3.2, class: cls } = Astro.props;
const { x, y, w, h } = SYMBOL.bladeBox;
const s = size / h;               // scale blade to `size` px tall
const bw = w * s, bh = size;
const tw = bw * gap, th = bh * 1.9; // tile spacing (generous negative space)
---
<svg class:list={['pattern', cls]} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" style={`opacity:${opacity}`}>
  <defs>
    <pattern id={id} width={tw} height={th * 2} patternUnits="userSpaceOnUse">
      <g fill={color}>
        <path d={SYMBOL.blade} transform={`translate(${-x * s} ${-y * s}) scale(${s})`} />
        <path d={SYMBOL.blade} transform={`translate(${tw / 2 - x * s} ${th - y * s}) scale(${s})`} />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
<style>
  .pattern { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
