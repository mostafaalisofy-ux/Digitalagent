---
// Architectural sculpture of the approved symbol: the exact silhouette, extruded in true CSS 3D
// (stacked layers of the same two paths — no redrawing, no face gradients). Intro follows the
// Bible's motion principle: T-form first, then the diagonal moves decisively into position.
import { SYMBOL } from '../lib/logo';
interface Props { layers?: number; depth?: number; class?: string; id?: string }
const { layers = 32, depth = 3, class: cls, id = 'sculpt' } = Astro.props;
const idx = Array.from({ length: layers }, (_, i) => i);
---
<div class:list={['sculpture', cls]} data-sculpture aria-hidden="true" style={`--depth:${depth}px`}>
  <svg class="sculpture__defs" width="0" height="0" focusable="false">
    <symbol id={`${id}-t`} viewBox={SYMBOL.viewBox}><path fill-rule="evenodd" d={SYMBOL.t} /></symbol>
    <symbol id={`${id}-b`} viewBox={SYMBOL.viewBox}><path fill-rule="evenodd" d={SYMBOL.blade} /></symbol>
  </svg>
  <div class="sculpture__rig">
    <div class="stack stack--t">
      {idx.slice().reverse().map((i) => (
        <svg class:list={['layer', { 'layer--face': i === 0, 'layer--rim': i === 1 }]} style={`--i:${i}`} viewBox={SYMBOL.viewBox}><use href={`#${id}-t`} /></svg>
      ))}
    </div>
    <div class="stack stack--b">
      {idx.slice().reverse().map((i) => (
        <svg class:list={['layer', { 'layer--face': i === 0, 'layer--rim': i === 1 }]} style={`--i:${i}`} viewBox={SYMBOL.viewBox}><use href={`#${id}-b`} /></svg>
      ))}
    </div>
  </div>
</div>

<style>
  .sculpture {
    --rx: 0deg; --ry: 0deg;
    position: relative; width: 100%; aspect-ratio: 600 / 721;
    perspective: 1500px; perspective-origin: 50% 40%;
  }
  .sculpture__defs { position: absolute; }
  .sculpture__rig {
    position: absolute; inset: 0; transform-style: preserve-3d;
    transform: rotateX(calc(7deg + var(--rx))) rotateY(calc(-21deg + var(--ry)));
    transition: transform 1.2s var(--ease-out);
  }
  .stack { position: absolute; inset: 0; transform-style: preserve-3d; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; transform: translateZ(calc(var(--i) * var(--depth) * -1)); }
  /* side walls shaded by depth: tints of palette colours, lighter at the front edge */
  .stack--t .layer { fill: color-mix(in srgb, var(--c-graphite), var(--c-white) calc(26% - var(--i) * 0.8%)); }
  .stack--b .layer { fill: color-mix(in srgb, var(--c-purple-900), var(--c-purple) calc(62% - var(--i) * 2%)); }
  /* single lit-edge layer: tints of approved palette values, not new colours */
  .stack--t .layer--rim { fill: color-mix(in srgb, var(--c-graphite), var(--c-white) 42%); }
  .stack--b .layer--rim { fill: color-mix(in srgb, var(--c-purple-900), var(--c-purple) 80%); }
  .stack--t .layer--face { fill: var(--c-white); }
  .stack--b .layer--face { fill: var(--c-purple); }

  /* Intro (transform-only inside the 3D context — opacity there would flatten the extrusion):
     the whole piece fades in from the outer wrapper, the T settles, then the blade arrives
     along its own 45° axis — "the diagonal moves decisively into position". */
  :global(.js) .sculpture { opacity: 0; animation: st-fade 0.7s var(--ease-out) 0.1s forwards; }
  :global(.js) .stack--t { transform: translate3d(0, 5%, 0); animation: st-t 1.1s var(--ease-out) 0.1s forwards; }
  :global(.js) .stack--b { transform: translate3d(22%, -22%, 0); animation: st-b 1.3s var(--ease-out) 0.55s forwards; }
  @keyframes st-fade { to { opacity: 1; } }
  @keyframes st-t { to { transform: none; } }
  @keyframes st-b { to { transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .sculpture__rig { transition: none; }
    :global(.js) .sculpture, :global(.js) .stack--t, :global(.js) .stack--b { opacity: 1; transform: none; animation: none; }
  }
</style>

<script>
  // Subtle pointer parallax (fine pointers only, reduced-motion respected, rAF-throttled).
  const fine = matchMedia('(pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !still) {
    document.querySelectorAll<HTMLElement>('[data-sculpture]').forEach((el) => {
      const host = el.closest('[data-sculpture-host]') ?? el;
      let raf = 0;
      host.addEventListener('pointermove', (e) => {
        const ev = e as PointerEvent;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = (host as HTMLElement).getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width - 0.5;
          const py = (ev.clientY - r.top) / r.height - 0.5;
          el.style.setProperty('--ry', `${(px * 14).toFixed(2)}deg`);
          el.style.setProperty('--rx', `${(-py * 8).toFixed(2)}deg`);
        });
      });
      host.addEventListener('pointerleave', () => { el.style.setProperty('--ry', '0deg'); el.style.setProperty('--rx', '0deg'); });
    });
  }
</script>
