---
// Case study component: headline KPI → insight → action reading order (Bible slide 37).
import CaseVisual from './CaseVisual.astro';
import type { Case } from '../data/cases';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
interface Props { c: Case; lang: Lang; index: number }
const { c, lang, index } = Astro.props;
const d = t(lang).work;
const lead = c.kpis.find((k) => k.accent) ?? c.kpis[0];
const flip = index % 2 === 1;
---
<article class:list={['cs', { 'cs--flip': flip }]} id={c.slug} aria-labelledby={`cs-${c.slug}`}>
  <div class="cs__visual"><CaseVisual id={`work-${c.slug}`} label={d.visual} kpi={lead.value} ratio="5 / 4" src={c.visual?.images[0].src ?? null} alt={c.visual?.images[0].alt[lang] ?? ''} /></div>
  <div class="cs__body">
    <p class="cs__tags"><span class="num cs__i">{String(index + 1).padStart(2, '0')}</span><span>{c.sector[lang]}</span><span>{c.market[lang]}</span><span>{c.period ? c.period[lang] : d.periodTbc}</span></p>
    <h2 class="cs__client" id={`cs-${c.slug}`}>{c.client[lang]}</h2>
    <p class="cs__headline">{c.headline[lang]}</p>
    <p class="cs__lead"><span class="num latin">{lead.value}</span><span>{lead.label[lang]}</span></p>
    <dl class="cs__story">
      <div><dt class="eyebrow">{d.challenge}</dt><dd>{c.challenge[lang]}</dd></div>
      <div><dt class="eyebrow">{d.approach}</dt><dd>{c.approach[lang]}</dd></div>
    </dl>
    <div class="cs__results">
      <p class="eyebrow">{d.results}</p>
      <dl class="cs__kpis">
        {c.kpis.map((k) => <div class:list={{ 'is-accent': k.accent }}><dt>{k.label[lang]}</dt><dd class="num latin">{k.value}</dd></div>)}
      </dl>
      {c.resultsNote && <p class="cs__note">{c.resultsNote[lang]}</p>}
    </div>
    <p class="cs__platforms latin">{c.platforms.join(' · ')}</p>
  </div>
</article>
<style>
  .cs { display: grid; gap: var(--s-6); padding-block: var(--s-9); border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .cs__body { display: grid; gap: var(--s-4); align-content: start; }
  .cs__tags { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); font-size: var(--fs-caption); color: var(--text-muted); }
  .cs__i { color: var(--accent-text); }
  .cs__client { font-size: var(--fs-h1); letter-spacing: var(--track-tight); }
  .cs__headline { font-size: var(--fs-lead); color: var(--text); max-width: 34ch; line-height: 1.45; }
  .cs__lead { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--s-3); padding-block: var(--s-4); border-block: 1px solid var(--line); color: var(--text-muted); }
  .cs__lead .num { font-size: var(--fs-kpi); font-weight: 700; line-height: 0.9; color: var(--accent); letter-spacing: -0.04em; }
  .cs__story { display: grid; gap: var(--s-4); }
  .cs__story dd { color: var(--text-muted); margin-top: var(--s-2); max-width: 52ch; }
  .cs__results { display: grid; gap: var(--s-3); }
  .cs__kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .cs__kpis > div { background: var(--bg); padding: var(--s-4); display: flex; flex-direction: column-reverse; gap: var(--s-1); }
  .cs__kpis dd { font-size: var(--fs-h2); font-weight: 700; color: var(--text-strong); line-height: 1; }
  .cs__kpis dt { font-size: var(--fs-caption); color: var(--text-muted); }
  .cs__kpis .is-accent dd { color: var(--accent-text); }
  .cs__note, .cs__platforms { font-size: var(--fs-caption); color: var(--text-muted); }
  @media (min-width: 1024px) {
    .cs { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; padding-block: var(--s-10); }
    .cs__visual { grid-column: 1 / span 6; position: sticky; top: 120px; }
    .cs__body { grid-column: 8 / -1; }
    .cs--flip .cs__visual { grid-column: 7 / -1; grid-row: 1; }
    .cs--flip .cs__body { grid-column: 1 / span 5; grid-row: 1; }
  }
</style>
