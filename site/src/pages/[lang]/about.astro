---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import HomeAbout from '../../components/home/HomeAbout.astro';
import Brands from '../../components/home/Brands.astro';
import Approach from '../../components/home/Approach.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Logo from '../../components/Logo.astro';
import { staticLangPaths } from '../../i18n/paths';
import { t } from '../../i18n/ui';
import { h } from '../../i18n/home';
import { SITE, type Lang } from '../../config/site';
export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const a = h(lang).aboutPage;
const schema = [{
  '@context': 'https://schema.org', '@type': 'AboutPage', inLanguage: lang,
  mainEntity: { '@type': 'Organization', name: SITE.name, url: SITE.url,
    founder: { '@type': 'Person', name: a.founderName, jobTitle: 'Founder', image: new URL('/team/mostafa-sofy.webp', SITE.url).href } },
}];
---
<Base lang={lang} page="about" title={d.meta.aboutTitle} description={d.meta.aboutDesc} schema={schema}>
  <PageHero eyebrow={d.nav.about} title={a.title} intro={a.intro} />
  <section class="section story" aria-labelledby="story-title">
    <div class="container story__grid">
      <h2 id="story-title" class="story__h" data-reveal>{a.storyTitle}</h2>
      <div class="story__body">{a.story.map((p, i) => <p data-reveal style={`--delay:${i * 80}ms`}>{p}</p>)}</div>
    </div>
  </section>
  <HomeAbout lang={lang} showMore={false} />
  <Approach lang={lang} />
  <Brands lang={lang} />
  <section class="section section--surface lead-sec" aria-labelledby="lead-title">
    <div class="container lead__grid">
      <h2 id="lead-title" class="story__h" data-reveal>{a.founderTitle}</h2>
      <!-- Photo supplied by the owner (2026-11-04). Biography appears here once supplied (OQ-40). -->
      <figure class="person" data-reveal>
        <div class="person__photo"><img src="/team/mostafa-sofy.webp" width="900" height="900" alt={a.photoAlt} loading="lazy" decoding="async" /></div>
        <figcaption class="person__text">
          <Logo variant="signature" height={28} decorative />
          <p class="person__name latin" lang="en">{a.founderName}</p>
          <p class="person__role">{a.founderRole}</p>
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="section values" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title" class="story__h" data-reveal>{a.valuesTitle}</h2>
      <ul role="list" class="values__list">
        {a.values.map((v, i) => <li data-reveal style={`--delay:${i * 60}ms`}><h3>{v.t}</h3><p>{v.d}</p></li>)}
      </ul>
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>
<style>
  .story__grid, .lead__grid { display: grid; gap: var(--s-5); }
  .story__h { font-size: var(--fs-h2); letter-spacing: var(--track-tight); }
  .story__body { display: grid; gap: var(--s-4); }
  .story__body p { font-size: var(--fs-lead); line-height: 1.6; max-width: 60ch; }
  .values__list { display: grid; border-top: 1px solid var(--line-strong); margin-top: var(--s-6); }
  .values__list li { padding-block: var(--s-5); border-bottom: 1px solid var(--line); display: grid; gap: var(--s-2); }
  .values__list h3 { font-size: var(--fs-h3); }
  .values__list p { color: var(--text-muted); }
  .person { margin: 0; display: grid; gap: var(--s-5); align-items: end; }
  .person__photo { width: 100%; max-width: 380px; aspect-ratio: 1; overflow: hidden; background: var(--bg); }
  .person__photo img { width: 100%; height: 100%; object-fit: cover; }
  .person__text { display: grid; gap: var(--s-2); justify-items: start; padding-top: var(--s-4); border-top: 3px solid var(--accent); max-width: 380px; }
  .person__text :global(.logo) { margin-bottom: var(--s-2); }
  .person__name { font-size: var(--fs-h2); font-weight: 700; color: var(--text-strong); }
  .person__role { color: var(--accent-text); font-weight: 500; }
  @media (min-width: 768px) { .values__list { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: var(--gutter); } .person { grid-template-columns: minmax(0, 380px) minmax(0, 1fr); column-gap: var(--s-7); } .person__text { border-top: 0; border-inline-start: 3px solid var(--accent); padding: 0 0 0 0; padding-inline-start: var(--s-5); align-self: end; } }
  @media (min-width: 1024px) { .story__grid, .lead__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); } .story__h { grid-column: 1 / span 4; } .story__body, .person { grid-column: 5 / -1; } }
</style>
