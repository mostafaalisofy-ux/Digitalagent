---
// Services: four disciplines, each a distinct block — index → numeral + name + value → services.
// Services whose scope is unconfirmed (OQ-34) show their summary only; no capability list is implied.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { DISCIPLINES } from '../../data/services';
import { SITE, type Lang } from '../../config/site';
import { staticLangPaths, href } from '../../i18n/paths';
import { t } from '../../i18n/ui';
export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
// Service schema: names and summaries as published, provider SayTamm, area served Saudi Arabia (verified facts only)
const schema = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: d.meta.servicesTitle,
  itemListElement: DISCIPLINES.flatMap((p) => p.services).map((s, i) => ({ '@type': 'ListItem', position: i + 1,
    item: { '@type': 'Service', name: s.name[lang], description: s.summary[lang], serviceType: s.name.en, areaServed: 'SA',
      provider: { '@type': 'Organization', name: SITE.name, url: SITE.url }, url: new URL(`${href(lang, 'services')}#${s.id}`, SITE.url).href } })) }];
---
<Base lang={lang} page="services" title={d.meta.servicesTitle} description={d.meta.servicesDesc} schema={schema}>
  <PageHero eyebrow={d.services.eyebrow} title={d.services.title} intro={d.services.intro} />

  <nav class="container dix" aria-label={d.services.index}>
    <ol role="list" class="dix__list">
      {DISCIPLINES.map((g) => (
        <li><a class="dix__a" href={`#${g.id}`}><span class="num latin dix__n">{g.n}</span><span class="dix__name">{g.name[lang]}</span><span class="dix__count">{d.services.count(g.services.length)}</span></a></li>
      ))}
    </ol>
  </nav>

  {DISCIPLINES.map((g, gi) => (
    <section class:list={['disc', { 'disc--alt': gi % 2 === 1 }]} id={g.id} aria-labelledby={`h-${g.id}`}>
      <figure class="container disc__media" aria-hidden="true">
        <img src={`/visuals/services-${g.id}.webp`} srcset={`/visuals/services-${g.id}-1200.webp 1200w, /visuals/services-${g.id}.webp 2400w`} sizes="(min-width: 1440px) 1300px, 100vw" width="2400" height="1350" alt="" loading="lazy" decoding="async" data-reveal="wipe" />
      </figure>
      <div class="container disc__grid">
        <header class="disc__head" data-reveal>
          <span class="disc__n num latin" aria-hidden="true">{g.n}</span>
          <h2 class="disc__name" id={`h-${g.id}`}>{g.name[lang]}</h2>
          <p class="disc__value">{g.value[lang]}</p>
        </header>
        <ol role="list" class="svc-list">
          {g.services.map((s) => (
            <li class:list={['svc', { 'svc--short': s.scopePending }]} id={s.id} data-reveal>
              <h3 class="svc__name">{s.name[lang]}</h3>
              <p class="svc__sum">{s.summary[lang]}</p>
              {!s.scopePending && (
                <div class="svc__inc">
                  <p class="svc__k">{d.services.includes}</p>
                  <ul role="list" class="svc__items">{s.includes[lang].map((x) => <li>{x}</li>)}</ul>
                </div>
              )}
              {s.scopePending && SITE.preview && <span class="tag-pending">{d.services.pending}</span>}
              <a class="link-diag svc__cta" href={`${href(lang, 'contact')}?service=${g.id}`} data-track="cta_click" data-cta-id={`service_${s.id}`} data-cta-location="services">{d.services.cta}<span class="sr-only">: {s.name[lang]}</span></a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
  <FinalCta lang={lang} />
</Base>
<style>
  .dix { padding-block: var(--s-7) 0; }
  .dix__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); }
  .dix__a { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-3) var(--s-4) 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; height: 100%; }
  .dix__n { font-size: var(--fs-small); font-weight: 700; color: var(--accent-text); }
  .dix__name { font-weight: 700; color: var(--text-strong); line-height: 1.25; }
  .dix__count { font-size: var(--fs-caption); color: var(--text-muted); }
  .dix__a:hover .dix__name, .dix__a:focus-visible .dix__name { color: var(--accent-text); }

  .disc { padding-block: var(--s-10); border-top: 1px solid var(--line); scroll-margin-top: 80px; }
  .disc--alt { background: var(--surface); }
  /* illustrative imagery (AI-generated, decorative only — never case material: docs/AI_VISUAL_PROMPTS.md) */
  .disc__media { margin: 0 auto var(--s-8); }
  .disc__media img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--surface); }
  @media (min-width: 1024px) { .disc__media img { aspect-ratio: 21 / 8; } }
  .disc__grid { display: grid; gap: var(--s-7); }
  .disc__head { display: grid; gap: var(--s-3); align-content: start; }
  .disc__n { font-size: clamp(4rem, 2.5rem + 6vw, 8.5rem); font-weight: 700; line-height: 0.85; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1.5px var(--c-purple-200); }
  .disc__name { font-size: var(--fs-h1); letter-spacing: var(--track-tight); line-height: 1.05; }
  .disc__value { font-size: var(--fs-lead); line-height: 1.5; color: var(--text); max-width: 36ch; }

  .svc-list { display: grid; border-top: 1px solid var(--line-strong); }
  .svc { display: grid; gap: var(--s-3); padding-block: var(--s-6); border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .svc__name { font-size: var(--fs-h2); letter-spacing: var(--track-tight); line-height: 1.1; }
  .svc__sum { font-size: var(--fs-lead); color: var(--text); max-width: 44ch; line-height: 1.5; }
  .svc__inc { display: grid; gap: var(--s-3); margin-top: var(--s-2); }
  .svc__k { font-size: var(--fs-eyebrow); text-transform: uppercase; letter-spacing: var(--track-eyebrow); color: var(--text-muted); font-weight: 500; }
  :global([dir='rtl']) .svc__k { text-transform: none; letter-spacing: 0; font-size: var(--fs-caption); }
  .svc__items { display: grid; gap: var(--s-2) var(--s-6); }
  .svc__items li { position: relative; padding-inline-start: var(--s-5); color: var(--text); line-height: 1.5; }
  .svc__items li::before { content: ''; position: absolute; inset-inline-start: 2px; top: 0.7em; width: 10px; height: 3px; background: var(--accent); transform: skewX(-45deg); }
  .svc .tag-pending { justify-self: start; }
  .svc__cta { justify-self: start; margin-top: var(--s-2); color: var(--text-strong); }
  @media (min-width: 768px) {
    .dix__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .dix__a { padding-inline-end: var(--s-4); }
    .svc__items { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .disc__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .disc__head { grid-column: 1 / span 4; position: sticky; top: 110px; align-self: start; }
    .svc-list { grid-column: 6 / -1; }
  }
</style>
