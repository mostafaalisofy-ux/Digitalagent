---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import Credibility from '../../components/home/Credibility.astro';
import Philosophy from '../../components/home/Philosophy.astro';
import Capabilities from '../../components/home/Capabilities.astro';
import SelectedWork from '../../components/home/SelectedWork.astro';
import Results from '../../components/home/Results.astro';
import Method from '../../components/home/Method.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { staticLangPaths } from '../../i18n/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../config/site';
export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDesc}>
  <Hero lang={lang} />
  <Credibility lang={lang} />
  <Philosophy lang={lang} />
  <Capabilities lang={lang} />
  <SelectedWork lang={lang} />
  <Results lang={lang} />
  <Method lang={lang} />
  <FinalCta lang={lang} />
</Base>
