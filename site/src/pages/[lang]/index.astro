---
// Homepage v0.2 — owner feedback: clear order. Hero → About → Services → Clients → Work → Process → Why → Contact.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import HomeAbout from '../../components/home/HomeAbout.astro';
import HomeServices from '../../components/home/HomeServices.astro';
import HomeClients from '../../components/home/HomeClients.astro';
import SelectedWork from '../../components/home/SelectedWork.astro';
import Process from '../../components/home/Process.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { staticLangPaths } from '../../i18n/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../config/site';
export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDesc}>
  <Hero lang={lang} />
  <HomeAbout lang={lang} />
  <HomeServices lang={lang} />
  <HomeClients lang={lang} />
  <SelectedWork lang={lang} />
  <Process lang={lang} />
  <WhyUs lang={lang} />
  <FinalCta lang={lang} />
</Base>
