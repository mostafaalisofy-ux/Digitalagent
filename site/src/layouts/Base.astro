---
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, DIR, type Lang } from '../config/site';
import { href, other, type PageKey } from '../i18n/paths';
import { t } from '../i18n/ui';

/** noindex: pages that must never be indexed in any stage (404). They get no canonical or hreflang. */
interface Props { lang: Lang; page: PageKey; title: string; description: string; paths?: Record<Lang, string>; schema?: object[]; noindex?: boolean }
const { lang, page, title, description, paths, schema = [], noindex = false } = Astro.props;
const d = t(lang);
// `paths` = this page's URL in each language (pages outside the fixed PageKey set, e.g. case studies)
const path = (l: Lang) => paths?.[l] ?? href(l, page);
const url = (l: Lang) => new URL(path(l), SITE.url).href;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SayTamm',
  url: SITE.url,
  inLanguage: ['en', 'ar'],
}, {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: SITE.nameAr,
  url: SITE.url,
  email: SITE.email,
  logo: new URL('/brand/SayTamm_Symbol_Black.png', SITE.url).href,
  slogan: 'Say it. Tamm it.',
  // Positioning D-020: a digital marketing & performance agency (no single-country restriction)
  description: 'A digital marketing and performance agency that brings strategy, creative, media and technology together under one connected approach to growth.',
  knowsLanguage: ['en', 'ar'],
}, ...schema];
---
<!doctype html>
<html lang={lang} dir={DIR[lang]} data-st-theme={SITE.theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {(SITE.preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <>
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="ar" href={url('ar')} />
    <link rel="alternate" hreflang="x-default" href={url('en')} />
  </>}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SayTamm" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url(lang)} />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
  <meta property="og:image" content={new URL(`/og/saytamm-og-${lang}.png`, SITE.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === 'ar' ? 'قول تم — شعار SayTamm' : 'SayTamm logo — Say it. Tamm it.'} />
  <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_SA'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL(`/og/saytamm-og-${lang}.png`, SITE.url).href} />
  <meta name="theme-color" content={SITE.theme === 'light' ? '#F5F3FA' : '#09090D'} />
  <link rel="icon" href="/brand/SayTamm_Symbol_Signature_Black-Purple.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/brand/SayTamm_Symbol_Signature_White-Purple.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
  {lang === 'en' && <link rel="preload" href="/fonts/satoshi/Satoshi-700.woff2" as="font" type="font/woff2" crossorigin />}
  <script is:inline>document.documentElement.classList.add('js');window.dataLayer=window.dataLayer||[];</script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body data-page={page}>
  <a class="skip-link" href="#main">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
  {SITE.preview && <div class="preview-bar" role="note"><span class="preview-bar__dot" aria-hidden="true"></span>{d.preview}</div>}
  <Header lang={lang} page={page} altHref={path(other(lang))} />
  <main id="main"><slot /></main>
  <Footer lang={lang} page={page} altHref={path(other(lang))} />

  <script>
    // Reveal-on-scroll. A rAF-throttled position check (not IntersectionObserver): IO treats a
    // target's own clip-path as its visible area, so clip-path wipes would never trigger, and
    // fast flicks can skip elements. Anything whose top has entered the viewport is revealed.
    let pending = [...document.querySelectorAll<Element>('[data-reveal], [data-reveal-group]')];
    let ticking = false;
    const check = () => {
      ticking = false;
      const limit = innerHeight * 0.98; // anything that starts in view is revealed (a CTA near the fold must never stay hidden)
      pending = pending.filter((el) => { if (el.getBoundingClientRect().top < limit) { el.classList.add('is-in'); return false; } return true; });
      if (!pending.length) { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(check); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    check();

    // In-view video (v1.1): muted loops play only while at least ~40% on screen and pause when they leave, so a page of
    // films costs nothing off screen. Same rAF position check as the reveals (clip-path frames would fool IO).
    // Reduced motion: nothing autoplays; the studio buttons still play with sound on request.
    const vids = [...document.querySelectorAll<HTMLVideoElement>('video.js-inview')];
    if (vids.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let vt = false;
      const vcheck = () => {
        vt = false;
        for (const v of vids) {
          const r = v.getBoundingClientRect(), vis = Math.max(0, Math.min(r.bottom, innerHeight) - Math.max(r.top, 0)) / (r.height || 1);
          const hvis = Math.max(0, Math.min(r.right, innerWidth) - Math.max(r.left, 0)) / (r.width || 1);
          if (vis > 0.4 && hvis > 0.5) { if (v.paused) { v.preload = 'auto'; v.play().catch(() => {}); } } else if (!v.paused) v.pause();
        }
      };
      const vs = () => { if (!vt) { vt = true; requestAnimationFrame(vcheck); } };
      addEventListener('scroll', vs, { passive: true }); addEventListener('resize', vs, { passive: true });
      document.querySelectorAll('.studio__row').forEach((r) => r.addEventListener('scroll', vs, { passive: true }));
      vcheck();
    }

    // v1.2 motion layer (styles/motion.css). Everything here is skipped under reduced motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // scroll progress
      const bar = document.createElement('div'); bar.className = 'progress'; bar.setAttribute('aria-hidden', 'true'); document.body.append(bar);
      // section titles rise word by word (split on spaces, so Arabic words keep their shaping)
      document.querySelectorAll<HTMLElement>('main h2[data-reveal]').forEach((h) => {
        if (h.querySelector('.w') || h.children.length) return;
        const words = (h.textContent || '').trim().split(/\s+/);
        h.innerHTML = words.map((w, i) => `<span class="w" style="--i:${i}">${w.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`).join(' ');
      });
      // the blade wipe on framed pictures
      const wipes = [...document.querySelectorAll<HTMLElement>('.cs__card img, .jr figure, .studio__frame')];
      wipes.forEach((el) => el.setAttribute('data-wipe', ''));
      // figures count up once, keeping their prefix, suffix, decimals and separators
      const counts = [...document.querySelectorAll<HTMLElement>('.who__facts dt, .cs__fig bdi')].map((el) => ({ el, txt: el.textContent || '', done: false }));
      const countUp = (o: { el: HTMLElement; txt: string }) => {
        const m = o.txt.match(/^([^\d]*)([\d,]+(?:\.\d+)?)(.*)$/); if (!m) return;
        const raw = m[2].replace(/,/g, ''), dec = (raw.split('.')[1] || '').length, end = parseFloat(raw), t0 = performance.now(), D = 1400;
        const tick = (now: number) => {
          const u = Math.min(1, (now - t0) / D), e = 1 - Math.pow(2, -10 * u), v = end * e;
          let n = v.toFixed(dec); if (m[2].includes(',')) n = Number(n).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
          o.el.textContent = u >= 1 ? o.txt : m[1] + n + m[3]; if (u < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const stage = document.getElementById('stage');
      let mt = false;
      const motion = () => {
        mt = false;
        const h = document.documentElement, max = h.scrollHeight - innerHeight; bar.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
        for (const el of wipes) if (!el.classList.contains('is-wiped') && el.getBoundingClientRect().top < innerHeight * 0.92 && el.getBoundingClientRect().left < innerWidth) el.classList.add('is-wiped');
        for (const o of counts) if (!o.done && o.el.getBoundingClientRect().top < innerHeight * 0.9) { o.done = true; countUp(o); }
        if (stage) stage.style.translate = `0 ${Math.min(120, scrollY * 0.12).toFixed(1)}px`;   // the stage drifts as the page scrolls
      };
      const mm = () => { if (!mt) { mt = true; requestAnimationFrame(motion); } };
      addEventListener('scroll', mm, { passive: true }); addEventListener('resize', mm, { passive: true });
      document.querySelectorAll('.studio__row').forEach((r) => r.addEventListener('scroll', mm, { passive: true }));
      motion();
      // primary buttons lean toward the pointer
      document.querySelectorAll<HTMLElement>('.btn--primary').forEach((b) => {
        b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.translate = `${((e.clientX - r.left) / r.width - 0.5) * 10}px ${((e.clientY - r.top) / r.height - 0.5) * 8}px`; });
        b.addEventListener('pointerleave', () => { b.style.translate = ''; });
      });
      // studio cards tilt toward the pointer
      document.querySelectorAll<HTMLElement>('.studio__frame').forEach((f) => {
        f.addEventListener('pointermove', (e) => { const r = f.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5; f.style.transform = `perspective(900px) rotateY(${x * 10}deg) rotateX(${-y * 8}deg) translateY(-4px)`; });
        f.addEventListener('pointerleave', () => { f.style.transform = ''; });
      });
    }

    // Analytics readiness: data-track="event_name" + data-* params → dataLayer (no tags fire here)
    document.addEventListener('click', (ev) => {
      const el = (ev.target as HTMLElement).closest<HTMLElement>('[data-track]');
      if (!el) return;
      (window as any).dataLayer.push({ event: el.dataset.track, cta_id: el.dataset.ctaId, cta_location: el.dataset.ctaLocation, language: document.documentElement.lang, page_type: document.body.dataset.page });
    });
  </script>
</body>
</html>

<style>
  .preview-bar { display: flex; align-items: center; justify-content: center; gap: var(--s-2); padding: 8px var(--margin); background: var(--c-graphite); border-bottom: 1px solid var(--line); color: var(--c-soft-white); font-size: var(--fs-caption); font-weight: 500; text-align: center; }
  .preview-bar__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-purple-200); }
</style>
