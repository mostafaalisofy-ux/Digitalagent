# SayTamm website — environment variables (names and descriptions only; no secrets are used).
# Copy to .env only if you want to set these locally. Neither is required for `npm run dev` or `npm run build`.

# Build stage. Leave unset (default) for STAGING: noindex on every page, robots.txt Disallow,
# preview bar, and unconfirmed case figures shown with a "Pending confirmation" tag.
# Set to "production" ONLY for the authorised launch build: indexable, no preview bar, and every
# case whose evidence.status is not "approved" has its figures withheld.
# `npm run build:production` sets this for you.
PUBLIC_STAGE=

# Deployment target. Set to "artifact" only to build the private claude.ai preview bundle
# (output goes to dist-artifact/, contact form shows the email instead of opening mail).
# `npm run build:preview-link` sets this for you. Leave unset for normal builds.
PUBLIC_DEPLOY_TARGET=

# Not used yet. There is no form backend, CRM, analytics or tag manager connected.
# When one is added, add its variable names here with descriptions, and keep real values out of the repository.
